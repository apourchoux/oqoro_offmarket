---
import type { Property, PropertyTransport } from '../../lib/types';

interface Props {
  property: Property;
  transports: PropertyTransport[];
}

const { property, transports } = Astro.props;

function transportIcon(type: string | null): string {
  const stroke = 'stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"';
  const t = (type ?? '').toLowerCase();
  if (t.includes('métro') || t.includes('metro') || t.includes('rer') || t.includes('train'))
    return `<svg viewBox="0 0 24 24" ${stroke}><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M8 19l-2 3"/><path d="M18 22l-2-3"/><circle cx="9" cy="15" r="1"/><circle cx="15" cy="15" r="1"/></svg>`;
  if (t.includes('bus'))
    return `<svg viewBox="0 0 24 24" ${stroke}><path d="M8 6v6"/><path d="M16 6v6"/><path d="M2 12h20"/><path d="M19 18v-12a3 3 0 0 0-3-3H8a3 3 0 0 0-3 3v12"/><circle cx="8" cy="18" r="2"/><circle cx="16" cy="18" r="2"/></svg>`;
  if (t.includes('vélo') || t.includes('velo') || t.includes('velib'))
    return `<svg viewBox="0 0 24 24" ${stroke}><circle cx="6" cy="15" r="4"/><circle cx="18" cy="15" r="4"/><path d="M6 15l3-7h6l3 7"/><path d="M9 8h2l4 7"/></svg>`;
  return `<svg viewBox="0 0 24 24" ${stroke}><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`;
}

const mapSrc =
  property.latitude && property.longitude
    ? `https://www.google.com/maps?q=${property.latitude},${property.longitude}&z=15&output=embed`
    : null;
---

{(transports.length > 0 || mapSrc) && (
  <section class="s">
    <h2>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      Localisation &amp; quartier
    </h2>

    {mapSrc && (
      <div class="map-wrap">
        <iframe src={mapSrc} title="Carte" loading="lazy"></iframe>
      </div>
    )}

    {transports.length > 0 && (
      <>
        <div class="poi-title">Transports &amp; commodités à proximité</div>
        <div class="poi-list">
          {transports.map((t) => (
            <div class="poi">
              <Fragment set:html={transportIcon(t.transport_type)} />
              <span class="nm">
                {t.name}
                {t.destination ? <span class="dst"> · {t.destination}</span> : null}
              </span>
              {t.time_label && <span class="di">{t.time_label}</span>}
            </div>
          ))}
        </div>
      </>
    )}
  </section>
)}

<style>
  section.s { padding: 28px 0; border-top: 1px solid var(--border-tertiary); }
  section.s h2 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--fg-heading);
    letter-spacing: -0.3px;
    margin: 0 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  section.s h2 svg { width: 17px; height: 17px; color: var(--brand-600); }

  .map-wrap {
    border-radius: 12px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: 16px;
    border: 1px solid var(--border-tertiary);
    background: linear-gradient(135deg, #E8EEF5, #DCE6F2);
  }
  .map-wrap iframe { width: 100%; height: 100%; border: 0; }

  .poi-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--fg-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 8px 0 10px;
  }
  .poi-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 24px;
  }
  .poi {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-tertiary);
    font-size: 13px;
  }
  .poi :global(svg) { width: 15px; height: 15px; color: var(--gray-500); flex: none; }
  .poi .nm { color: var(--fg-secondary); flex: 1; }
  .poi .nm .dst { color: var(--fg-tertiary); }
  .poi .di { color: var(--fg-tertiary); font-size: 12px; }

  @media (max-width: 1024px) { .poi-list { grid-template-columns: 1fr; } }
</style>
