---
interface Props {
  matterportUrl: string | null;
  bgImage?: string;
}

const { matterportUrl, bgImage } = Astro.props;

// Reformat Matterport URLs so the embed actually works in an iframe.
// Common shapes:
//   https://my.matterport.com/show/?m=XXX
//   https://my.matterport.com/show?m=XXX&play=1
//   https://discover.matterport.com/space/XXX
//
// Toute URL non-http(s) est refusée : empêche `javascript:` ou `data:` URI
// d'arriver dans iframe.src (XSS sur l'origine parente).
function buildEmbedUrl(rawUrl: string): string | null {
  try {
    const u = new URL(rawUrl);
    if (u.protocol !== 'https:' && u.protocol !== 'http:') return null;
    if (u.hostname.includes('matterport.com')) {
      if (!u.searchParams.has('play')) u.searchParams.set('play', '1');
      if (!u.searchParams.has('qs')) u.searchParams.set('qs', '1');
    }
    return u.toString();
  } catch {
    return null;
  }
}

const embedUrl = matterportUrl ? buildEmbedUrl(matterportUrl) : null;
---

{matterportUrl && embedUrl && (
  <section class="s">
    <h2>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
      Visite virtuelle Matterport
    </h2>

    <div class="visit3d-card" data-mp-embed={embedUrl} data-mp-fallback={matterportUrl}>
      <button type="button" class="visit3d-teaser" aria-label="Lancer la visite virtuelle">
        {bgImage && <img src={bgImage} alt="" />}
        <div class="visit3d-overlay"></div>
        <div class="visit3d-inner">
          <div class="play">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
          <h3>Visite 3D Matterport</h3>
          <p>Cliquez pour explorer chaque pièce à 360°</p>
        </div>
      </button>
    </div>

    <div class="visit3d-footer">
      <a href={matterportUrl} target="_blank" rel="noopener" class="open-new">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
        Ouvrir dans un nouvel onglet
      </a>
    </div>
  </section>
)}

<style>
  section.s { padding: 28px 0; border-top: 1px solid var(--border-tertiary); }
  section.s h2 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--fg-heading);
    letter-spacing: -0.3px;
    margin: 0 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  section.s h2 svg { width: 17px; height: 17px; color: var(--brand-600); }

  .visit3d-card {
    position: relative;
    background: var(--oqoro-blue);
    border-radius: 14px;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    color: #fff;
  }
  .visit3d-card iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .visit3d-teaser {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .visit3d-teaser img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
  }
  .visit3d-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(34, 26, 91, 0.6), rgba(91, 48, 243, 0.5));
  }
  .visit3d-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
  }
  .visit3d-inner .play {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.12);
    color: var(--brand-700);
    transition: transform .2s;
  }
  .visit3d-teaser:hover .play { transform: scale(1.05); }
  .visit3d-inner .play svg { width: 24px; height: 24px; margin-left: 3px; }
  .visit3d-inner h3 {
    font-family: var(--font-display);
    font-size: 20px;
    margin: 0 0 4px;
    color: #fff;
    letter-spacing: -0.3px;
    font-weight: 700;
  }
  .visit3d-inner p {
    font-size: 13px;
    opacity: 0.85;
    margin: 0;
  }

  .visit3d-footer {
    margin-top: 12px;
    text-align: right;
  }
  .open-new {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-tertiary);
    text-decoration: none;
  }
  .open-new:hover { color: var(--fg-heading); }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>('.visit3d-card[data-mp-embed]').forEach((card) => {
    const teaser = card.querySelector<HTMLButtonElement>('.visit3d-teaser');
    const embedUrl = card.getAttribute('data-mp-embed');
    if (!teaser || !embedUrl) return;

    teaser.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.allow = 'fullscreen; xr-spatial-tracking; gyroscope; accelerometer';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      teaser.replaceWith(iframe);
    });
  });
</script>
