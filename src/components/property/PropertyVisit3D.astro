---
interface Props {
  matterportUrl: string | null;
  bgImage?: string;
}

const { matterportUrl, bgImage } = Astro.props;
---

{matterportUrl && (
  <section class="s">
    <h2>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
      Visite virtuelle Matterport
    </h2>
    <a href={matterportUrl} target="_blank" rel="noopener" class="visit3d-card">
      {bgImage && <img src={bgImage} alt="" />}
      <div class="visit3d-inner">
        <div class="play">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        </div>
        <h3>Visite 3D Matterport</h3>
        <p>Explorez chaque pièce à 360°</p>
      </div>
    </a>
  </section>
)}

<style>
  section.s { padding: 28px 0; border-top: 1px solid var(--border-tertiary); }
  section.s h2 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--fg-heading);
    letter-spacing: -0.3px;
    margin: 0 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  section.s h2 svg { width: 17px; height: 17px; color: var(--brand-600); }

  .visit3d-card {
    display: block;
    background: var(--oqoro-blue);
    border-radius: 14px;
    aspect-ratio: 16 / 8;
    position: relative;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }
  .visit3d-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
  }
  .visit3d-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(34, 26, 91, 0.6), rgba(91, 48, 243, 0.5));
  }
  .visit3d-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
  }
  .visit3d-inner .play {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.12);
    color: var(--brand-700);
    transition: transform .2s;
  }
  .visit3d-card:hover .visit3d-inner .play { transform: scale(1.05); }
  .visit3d-inner .play svg { width: 24px; height: 24px; margin-left: 3px; }
  .visit3d-inner h3 {
    font-family: var(--font-display);
    font-size: 20px;
    margin: 0 0 4px;
    color: #fff;
    letter-spacing: -0.3px;
    font-weight: 700;
  }
  .visit3d-inner p {
    font-size: 13px;
    opacity: 0.85;
    margin: 0;
  }
</style>
