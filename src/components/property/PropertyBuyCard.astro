---
import type { Property, PropertyFinancials } from '../../lib/types';
import { formatEur } from '../../lib/format';

interface Props {
  property: Property;
  financials: PropertyFinancials;
}

const { property, financials } = Astro.props;

const surface = property.total_surface ?? 0;
const pricePerM = surface > 0 ? Math.round(property.sale_price / surface) : null;

const yieldLabel = `${(financials.gross_yield ?? 0).toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 2 })} %`;
const occupancyLabel =
  financials.total_lots > 0
    ? `${Math.round((financials.rented_lots / financials.total_lots) * 100)} %`
    : '—';
const rentLabel = formatEur(financials.monthly_rent_cc);

const totalProject = property.total_project ?? property.sale_price + (property.notary_fees ?? 0);

const agentName = 'Camille Loubet';
const agentRole = 'Conseillère Off Market';
const agentInitials = 'CL';
const agentPhone = '+33180000000';
---

<aside>
  <div class="buy-card">
    <div class="price">{formatEur(property.sale_price)}</div>
    {pricePerM && <div class="ppm">{formatEur(pricePerM)}/m² · Total projet {formatEur(totalProject)}</div>}

    <div class="yield-row">
      <div class="it">
        <div class="v">{yieldLabel}</div>
        <div class="l">Rendement brut</div>
      </div>
      <div class="it">
        <div class="v">{occupancyLabel}</div>
        <div class="l">Occupation 12 m</div>
      </div>
      <div class="it">
        <div class="v">{rentLabel}</div>
        <div class="l">Loyer / mois</div>
      </div>
    </div>

    <div class="row"><span>Prix de vente FAI</span><b>{formatEur(property.sale_price)}</b></div>
    {property.notary_fees > 0 && (
      <div class="row">
        <span>Frais de notaire (~{(property.notary_rate * 100).toLocaleString('fr-FR', { maximumFractionDigits: 1 })} %)</span>
        <b>~ {formatEur(property.notary_fees)}</b>
      </div>
    )}
    <div class="row total"><span>Total projet</span><b>{formatEur(totalProject)}</b></div>

    <button type="button" class="btn btn-primary" data-cta="rdv">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Prendre rendez-vous
    </button>

    <div class="agent">
      <div class="av">{agentInitials}</div>
      <div style="flex:1">
        <div class="nm">{agentName}</div>
        <div class="rl">{agentRole}</div>
      </div>
      <a class="ic" title="Téléphone" href={`tel:${agentPhone}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--brand-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </a>
    </div>
  </div>
</aside>

<style>
  aside { position: relative; }
  .buy-card {
    background: #fff;
    border: 1px solid var(--border-secondary);
    border-radius: 14px;
    padding: 22px;
    position: sticky;
    top: 24px;
    box-shadow: var(--shadow-sm);
  }
  .price {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.8px;
    color: var(--fg-heading);
    line-height: 1;
  }
  .ppm { font-size: 13px; color: var(--fg-tertiary); margin-top: 6px; }

  .yield-row {
    display: flex;
    gap: 12px;
    margin: 16px 0;
    padding: 14px 0;
    border-top: 1px solid var(--border-tertiary);
    border-bottom: 1px solid var(--border-tertiary);
  }
  .yield-row .it { flex: 1; }
  .yield-row .v {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    color: var(--brand-700);
    letter-spacing: -0.4px;
    line-height: 1;
  }
  .yield-row .l {
    font-size: 11px;
    color: var(--fg-tertiary);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .row {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    font-size: 13px;
    color: var(--fg-secondary);
  }
  .row b { font-weight: 700; color: var(--fg-heading); }
  .row.total {
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px solid var(--border-tertiary);
    font-size: 14px;
  }
  .row.total b { color: var(--brand-700); }

  .btn {
    height: 42px;
    padding: 0 18px;
    border-radius: 8px;
    font: 600 14px var(--font-sans);
    border: 1px solid transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    transition: background-color .2s, color .2s, border-color .2s;
    box-shadow: var(--shadow-xs);
    width: 100%;
    margin-top: 14px;
  }
  .btn svg { width: 16px; height: 16px; }
  .btn-primary { background: var(--brand-600); color: #fff; }
  .btn-primary:hover { background: var(--brand-700); }
  .btn-secondary { background: #fff; color: var(--fg-heading); border-color: var(--border-primary); }
  .btn-secondary:hover { background: var(--gray-50); }

  .agent {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border-tertiary);
  }
  .agent .av {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--brand-100);
    color: var(--brand-700);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 12px;
    flex: none;
  }
  .agent .nm { font-size: 13px; font-weight: 700; color: var(--fg-heading); }
  .agent .rl { font-size: 12px; color: var(--fg-tertiary); margin-top: 1px; }
  .agent .ic {
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-primary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: none;
  }
  .agent .ic:hover { background: var(--gray-50); }
  .agent .ic svg { width: 14px; height: 14px; }

  @media (max-width: 1024px) {
    .buy-card { position: static; }
  }
</style>
