---
import type { Property, PropertyFinancials } from '../../lib/types';
import { PROPERTY_TYPE_LABELS, MANAGEMENT_TYPE_LABELS } from '../../lib/types';
import { formatSurface } from '../../lib/format';

interface Props {
  property: Property;
  financials: PropertyFinancials;
}

const { property, financials } = Astro.props;

const stroke = 'stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"';

function svgFor(name: string): string {
  switch (name) {
    case 'key':
      return `<svg viewBox="0 0 24 24" ${stroke}><circle cx="8" cy="15" r="4"/><path d="M10.85 12.15 19 4"/><path d="m18 5 2 2"/><path d="m15 8 2 2"/></svg>`;
    case 'home':
      return `<svg viewBox="0 0 24 24" ${stroke}><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`;
    case 'maximize-2':
      return `<svg viewBox="0 0 24 24" ${stroke}><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>`;
    case 'building-2':
      return `<svg viewBox="0 0 24 24" ${stroke}><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="22" x2="9" y2="2"/><line x1="15" y1="22" x2="15" y2="2"/></svg>`;
    case 'zap':
      return `<svg viewBox="0 0 24 24" ${stroke}><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`;
    case 'flame':
      return `<svg viewBox="0 0 24 24" ${stroke}><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`;
    case 'users':
      return `<svg viewBox="0 0 24 24" ${stroke}><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`;
    case 'shield-check':
      return `<svg viewBox="0 0 24 24" ${stroke}><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`;
    case 'calendar-clock':
      return `<svg viewBox="0 0 24 24" ${stroke}><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="16" cy="16" r="3"/><path d="M16 14.5V16l1 .5"/></svg>`;
    default:
      return `<svg viewBox="0 0 24 24" ${stroke}><circle cx="12" cy="12" r="9"/></svg>`;
  }
}

const typeLabel = property.property_type ? PROPERTY_TYPE_LABELS[property.property_type] : '—';
const surfaceLabel = property.total_surface ? formatSurface(property.total_surface) : '—';
const floorLabel =
  property.floor === null
    ? '—'
    : property.floor === 0
      ? 'Rez-de-chaussée'
      : `${property.floor}${property.floor === 1 ? 'er' : 'e'} étage`;
const dpeLabel = property.dpe_energy_class ? `Classe ${property.dpe_energy_class}` : '—';
const heatingLabel = property.heating_type ?? '—';
const mgmtLabel = property.management_type
  ? `${MANAGEMENT_TYPE_LABELS[property.management_type]} · incluse`
  : 'Gestion OQORO incluse';
const tenantLabel =
  financials.total_lots > 0
    ? financials.rented_lots > 0
      ? `${financials.rented_lots} en place`
      : 'À louer'
    : 'En place';
const dispoLabel = financials.rented_lots > 0 ? 'Avec locataire' : 'Libre à la vente';

const features: Array<{ ic: string; l: string; v: string }> = [
  { ic: 'key', l: 'Type', v: typeLabel },
  ...(property.nb_rooms !== null ? [{ ic: 'home', l: 'Pièces', v: String(property.nb_rooms) }] : []),
  { ic: 'maximize-2', l: 'Surface', v: surfaceLabel },
  { ic: 'building-2', l: 'Étage', v: floorLabel },
  { ic: 'zap', l: 'DPE', v: dpeLabel },
  { ic: 'flame', l: 'Chauffage', v: heatingLabel },
  { ic: 'users', l: 'Locataire', v: tenantLabel },
  { ic: 'shield-check', l: 'Gestion OQORO', v: mgmtLabel },
  { ic: 'calendar-clock', l: 'Disponibilité', v: dispoLabel },
];
---

<section class="s">
  <h2>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
    Caractéristiques du bien
  </h2>
  <div class="features">
    {features.map((f) => (
      <div class="feat">
        <Fragment set:html={svgFor(f.ic)} />
        <span class="l">{f.l}</span>
        <span class="v">{f.v}</span>
      </div>
    ))}
  </div>
</section>

<style>
  section.s { padding: 28px 0; border-top: 1px solid var(--border-tertiary); }
  section.s h2 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--fg-heading);
    letter-spacing: -0.3px;
    margin: 0 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  section.s h2 svg { width: 17px; height: 17px; color: var(--brand-600); }

  .features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 32px;
  }
  .feat {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-tertiary);
    font-size: 14px;
  }
  .feat :global(svg) { width: 16px; height: 16px; color: var(--gray-500); flex: none; }
  .feat .l { color: var(--fg-secondary); flex: 1; }
  .feat .v { font-weight: 600; color: var(--fg-heading); }

  @media (max-width: 1024px) { .features { grid-template-columns: 1fr; } }
</style>
