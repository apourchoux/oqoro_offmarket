---
import type { PropertyPhoto } from '../../lib/types';

interface Props {
  photos: PropertyPhoto[];
  title: string;
  matterportUrl?: string | null;
}

const { photos, title, matterportUrl } = Astro.props;

// Mosaic uses up to 5 images; first is the big one.
const slots = photos.slice(0, 5);
const remaining = Math.max(0, photos.length - 5);
---

{slots.length > 0 && (
  <div class="gallery">
    {slots.map((p, i) => (
      <div class:list={['g', i === 0 && 'g1']}>
        <img src={p.url} alt={p.label ?? title} loading={i === 0 ? 'eager' : 'lazy'} />
        {i === slots.length - 1 && remaining > 0 && (
          <div class="more">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            + {remaining} photo{remaining > 1 ? 's' : ''}
          </div>
        )}
      </div>
    ))}
    <div class="top-actions">
      {matterportUrl && (
        <a class="pill" href={matterportUrl} target="_blank" rel="noopener">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
          Visite 3D
        </a>
      )}
      <span class="pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
        Galerie
      </span>
    </div>
  </div>
)}

<style>
  .gallery {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 6px;
    height: 380px;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 28px;
    position: relative;
  }
  .gallery .g {
    background: var(--gray-100);
    overflow: hidden;
    cursor: pointer;
    transition: opacity .25s;
    position: relative;
  }
  .gallery .g:hover { opacity: .92; }
  .gallery .g img { width: 100%; height: 100%; object-fit: cover; }
  .gallery .g1 { grid-row: 1 / span 2; }

  .gallery .more {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: rgba(255, 255, 255, 0.96);
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-heading);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: var(--shadow-sm);
  }

  .gallery .top-actions {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    gap: 8px;
  }
  .gallery .top-actions .pill {
    background: rgba(255, 255, 255, 0.96);
    padding: 7px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-heading);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    text-decoration: none;
  }
  .gallery .top-actions .pill:hover { background: #fff; text-decoration: none; }

  @media (max-width: 1024px) {
    .gallery { height: 320px; }
  }
  @media (max-width: 640px) {
    .gallery { grid-template-columns: 1fr 1fr; height: 260px; }
    .gallery .g1 { grid-row: 1; grid-column: 1 / -1; }
    .gallery .g:nth-child(5) { display: none; }
  }
</style>
