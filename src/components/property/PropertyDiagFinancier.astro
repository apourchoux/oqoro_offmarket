---
import type { Property, PropertyFinancials } from '../../lib/types';

interface Props {
  property: Property;
  financials: PropertyFinancials;
}

const { property, financials } = Astro.props;

const monthlyRent = financials.monthly_rent_cc ?? 0;

// Vacance locative = part du loyer perdue à cause du taux d'occupation
// moyen du quartier (donnée OQORO). Si non renseigné, on n'applique rien.
const occupancyRate = property.zone_occupancy_rate;
const vacancyPct =
  occupancyRate !== null && occupancyRate !== undefined
    ? Math.max(0, 100 - occupancyRate)
    : 0;
const vacancy = (monthlyRent * vacancyPct) / 100;

// Phase 3 : valeurs réelles si renseignées, sinon estimations.
const charges = property.monthly_charges ?? monthlyRent * 0.088;
const tax =
  property.yearly_property_tax !== null
    ? property.yearly_property_tax / 12
    : monthlyRent * 0.072;
const mgmt = property.monthly_management_fee ?? monthlyRent * 0.08;
const cashflow = Math.max(0, monthlyRent - vacancy - charges - tax - mgmt);

const total = monthlyRent || 1;
const segs = [
  { label: 'Cashflow', value: cashflow, color: 'var(--brand-600)' },
  ...(vacancy > 0
    ? [{ label: 'Vacance locative', value: vacancy, color: 'var(--oqoro-blue)' }]
    : []),
  { label: 'Charges copropriété', value: charges, color: 'var(--oqoro-saumon)' },
  { label: 'Taxe foncière', value: tax, color: 'var(--brand-200)' },
  { label: 'Gestion & assurance', value: mgmt, color: 'var(--gray-300)' },
];
const segsPct = segs.map((s) => ({
  ...s,
  pct: (s.value / total) * 100,
  pctLabel: `${((s.value / total) * 100).toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} %`,
}));
---

{monthlyRent > 0 && (
  <section class="s">
    <h2>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
      Diagnostic financier
    </h2>
    <div class="diag-bar">
      {segsPct.map((s) => (
        <span style={`width: ${s.pct}%; background: ${s.color};`}></span>
      ))}
    </div>
    <div class="diag-legend">
      {segsPct.map((s) => (
        <div class="leg">
          <span class="sw" style={`background: ${s.color};`}></span>
          <span class="lab">{s.label}</span>
          <span class="v">{s.pctLabel}</span>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  section.s { padding: 28px 0; border-top: 1px solid var(--border-tertiary); }
  section.s h2 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--fg-heading);
    letter-spacing: -0.3px;
    margin: 0 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  section.s h2 svg { width: 17px; height: 17px; color: var(--brand-600); }

  .diag-bar {
    display: flex;
    height: 14px;
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .diag-bar span { display: block; }
  .diag-legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 24px;
  }
  .leg {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    padding: 4px 0;
  }
  .leg .sw { width: 10px; height: 10px; border-radius: 3px; flex: none; }
  .leg .lab { color: var(--fg-secondary); flex: 1; }
  .leg .v { font-weight: 700; color: var(--fg-heading); }

  @media (max-width: 1024px) { .diag-legend { grid-template-columns: 1fr; } }
</style>
