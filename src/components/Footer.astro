  { name: 'Dijon', href: '/gestion-locative/dijon' },
  { name: 'Besançon', href: '/gestion-locative/besancon' },
  { name: 'Valence', href: '/gestion-locative' },
  { name: 'Nantes', href: '/gestion-locative/nantes' },
  { name: 'Reims', href: '/gestion-locative/reims' },
  { name: 'Metz', href: '/gestion-locative/metz' },
  { name: 'Clermont-Ferrand', href: '/gestion-locative/clermont-ferrand' },
  { name: 'Nîmes', href: '/gestion-locative/nimes' },
  { name: 'Orléans', href: '/gestion-locative/orleans' },
  { name: 'Strasbourg', href: '/gestion-locative/strasbourg' },
  { name: 'La Rochelle', href: '/gestion-locative' },
  { name: 'Avignon', href: '/gestion-locative/avignon' },
  { name: 'Chambéry', href: '/gestion-locative/chambery' },
  { name: 'Pau', href: '/gestion-locative/pau' },
  { name: 'Nice', href: '/gestion-locative/nice' },
  { name: 'Marseille', href: '/gestion-locative/marseille' },
  { name: 'Annemasse', href: '/gestion-locative/annemasse' },
];

function fullUrl(href: string, external?: boolean): string {
  if (external) return href;
  return href.startsWith('http') ? href : `${OQORO}${href}`;
}
---

<footer class="oq-footer">
  <div class="oq-container py-16">
    {seoSections.map((section) => (
      <section class="seo-section">
        <h3>{section.title}</h3>
        <p class="seo-desc">{section.description}</p>
        <div class="seo-grid">
          {section.cities.map((city) => (
            <a href={fullUrl(city.href)}>{city.name}</a>
          ))}
        </div>
      </section>
    ))}

    <div class="brand-block">
      <div class="brand-col">
        <img src="/oqoro/logos/oqoro-logo-white.svg" alt="OQORO" class="brand-logo" />
        <p class="carte-pro">
          Carte professionnelle :<br />
          n°CPI 6901 2019 000 039 604
        </p>
      </div>

      <div>
        <h4>Nos services</h4>
        <ul>
          {services.map((item) => (
            <li><a href={fullUrl(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Nos outils</h4>
        <ul>
          {tools.map((item) => (
            <li><a href={fullUrl(item.href, item.external)}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Société</h4>
        <ul>
          {company.map((item) => (
            <li><a href={fullUrl(item.href, item.external)}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <nav class="gestion-cities" aria-label="Gestion locative par ville">
      {gestionCities.map((city, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true">·</span>}
          <a href={fullUrl(city.href)}>Gestion locative à {city.name}</a>
        </>
      ))}
    </nav>

    <div class="copyright">
      Copyright<sup>©</sup> {year}. Tous droits réservés. Fait avec
      <span class="heart" aria-label="amour" role="img">❤️</span>
      à Lyon &amp; Paris.
    </div>
  </div>
</footer>

<style>
  .oq-footer {
    background: var(--oqoro-blue);
    color: rgba(255, 255, 255, 0.7);
  }

  .seo-section {
    margin-bottom: 40px;
  }
  .seo-section h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 6px;
    letter-spacing: -0.2px;
  }
  .seo-section .seo-desc {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 16px;
  }
  .seo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px 24px;
  }
  .seo-grid a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-size: 14px;
    transition: color .2s;
  }
  .seo-grid a:hover {
    color: #fff;
    text-decoration: none;
  }

  .brand-block {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 32px;
    padding-top: 24px;
    margin-bottom: 40px;
  }
  .brand-col { display: flex; flex-direction: column; gap: 18px; }
  .brand-logo { height: 28px; width: auto; }
  .carte-pro {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.5;
  }

  .oq-footer h4 {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 14px;
    letter-spacing: 0;
  }
  .oq-footer ul { list-style: none; padding: 0; margin: 0; }
  .oq-footer li {
    margin-bottom: 10px;
    font-size: 14px;
  }
  .oq-footer a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color .2s;
  }
  .oq-footer a:hover {
    color: #fff;
    text-decoration: none;
  }

  .gestion-cities {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 2;
    margin-bottom: 32px;
  }
  .gestion-cities a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }
  .gestion-cities a:hover { color: #fff; }
  .gestion-cities .sep {
    color: rgba(255, 255, 255, 0.25);
    margin: 0 8px;
  }

  .copyright {
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
  }
  .copyright sup { font-size: 0.7em; vertical-align: super; }
  .copyright .heart {
    display: inline-block;
    margin: 0 2px;
    font-size: 14px;
  }

  @media (max-width: 1024px) {
    .brand-block { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
    .seo-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .brand-block { grid-template-columns: 1fr; }
    .seo-grid { grid-template-columns: repeat(2, 1fr); }
    .gestion-cities { line-height: 1.9; }
  }
</style>
