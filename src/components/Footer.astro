---
const year = new Date().getFullYear();
---

<footer class="oq-footer">
  <div class="oq-container py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-12 mb-12">
      <div class="md:col-span-1">
        <img src="/oqoro/logos/oqoro-logo-white.svg" alt="OQORO" class="h-[28px] mb-5" />
        <p class="text-[14px] leading-[1.6] max-w-[320px] text-white/70">
          Les biens en gestion OQORO à la vente. Des données locatives réelles,
          certifiées et vérifiées par nos équipes.
        </p>
      </div>

      <div>
        <h4>Découvrir</h4>
        <ul>
          <li><a href="/#biens">Nos biens</a></li>
          <li><a href="/#pourquoi">Notre approche</a></li>
          <li><a href="/#temoignages">Témoignages</a></li>
          <li><a href="/#alerte">M'alerter</a></li>
        </ul>
      </div>

      <div>
        <h4>OQORO</h4>
        <ul>
          <li><a href="https://oqoro.com">Gestion locative</a></li>
          <li><a href="https://oqoro.com">Espace propriétaire</a></li>
          <li><a href="https://oqoro.com">Espace locataire</a></li>
          <li><a href="https://oqoro.com">Carrières</a></li>
        </ul>
      </div>

      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:offmarket@oqoro.com">offmarket@oqoro.com</a></li>
          <li class="text-white/70">107 boulevard Vivier Merle, 69003 Lyon</li>
        </ul>
      </div>
    </div>

    <div class="oq-footer-bottom">
      <span>© {year} OQORO. Tous droits réservés.</span>
      <div class="flex flex-wrap gap-6">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
        <a href="/cgu">CGU</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .oq-footer {
    background: var(--oqoro-blue);
    color: rgba(255, 255, 255, 0.7);
  }
  .oq-footer h4 {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 16px;
  }
  .oq-footer ul { list-style: none; padding: 0; margin: 0; }
  .oq-footer li {
    margin-bottom: 10px;
    font-size: 14px;
  }
  .oq-footer a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color .2s;
  }
  .oq-footer a:hover {
    color: #fff;
    text-decoration: none;
  }
  .oq-footer-bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
