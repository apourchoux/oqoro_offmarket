  { label: 'Politique confidentialité', href: '/pages/politique-confidentialite' },
  { label: 'Mentions légales', href: '/pages/mentions-legales' },
  { label: "Conditions générales d'utilisation", href: '/pages/cgu' },
];

const gestionCities = [
  { name: 'Paris', href: '/gestion-locative/paris' },
  { name: 'Lyon', href: '/gestion-locative/lyon' },
  { name: 'Lille', href: '/gestion-locative/lille' },
  { name: 'Bordeaux', href: '/gestion-locative/bordeaux' },
  { name: 'Toulouse', href: '/gestion-locative/toulouse' },
  { name: 'Angoulême', href: '/gestion-locative' },
  { name: 'Caen', href: '/gestion-locative' },
  { name: 'Tours', href: '/gestion-locative/tours' },
  { name: 'Angers', href: '/gestion-locative/angers' },
  { name: 'Grenoble', href: '/gestion-locative/grenoble' },
  { name: 'Bourgoin-Jallieu', href: '/gestion-locative' },
  { name: 'Mulhouse', href: '/gestion-locative/mulhouse' },
  { name: 'Nancy', href: '/gestion-locative/nancy' },
  { name: 'Brest', href: '/gestion-locative/brest' },
  { name: 'Rennes', href: '/gestion-locative/rennes' },
  { name: 'Saint-Étienne', href: '/gestion-locative/saint-etienne' },
  { name: 'Amiens', href: '/gestion-locative/amiens' },
  { name: 'Montpellier', href: '/gestion-locative/montpellier' },
  { name: 'Mâcon', href: '/gestion-locative/' },
  { name: 'Limoges', href: '/gestion-locative/limoges' },
