---
import type { PropertyLot } from '../lib/types';
import { LOT_STATUS_LABELS } from '../lib/types';
import { formatEur, formatSurface } from '../lib/format';
import Badge from './Badge.astro';

interface Props {
  lots: PropertyLot[];
}

const { lots } = Astro.props;
const sorted = [...lots].sort((a, b) => a.sort_order - b.sort_order);

const totalHC = sorted.reduce((acc, l) => acc + l.rent_hc, 0);
const totalCharges = sorted.reduce((acc, l) => acc + l.charges, 0);
const totalCC = totalHC + totalCharges;

function statusVariant(s: PropertyLot['status']): 'green' | 'red' | 'orange' {
  if (s === 'loue') return 'green';
  if (s === 'preavis') return 'orange';
  return 'red';
}
---

<div class="overflow-x-auto -mx-4 md:mx-0">
  <table class="w-full text-[14px]">
    <thead>
      <tr class="border-b border-oq-border text-left text-[12px] uppercase tracking-wider text-oq-muted">
        <th class="py-3 pr-3 font-semibold">Lot</th>
        <th class="py-3 px-3 font-semibold text-right">Surface</th>
        <th class="py-3 px-3 font-semibold text-right">Loyer HC</th>
        <th class="py-3 px-3 font-semibold text-right">Charges</th>
        <th class="py-3 px-3 font-semibold text-right">Loyer CC</th>
        <th class="py-3 pl-3 font-semibold text-right">Statut</th>
      </tr>
    </thead>
    <tbody>
      {sorted.map((lot) => (
        <tr class="border-b border-oq-border">
          <td class="py-3 pr-3 font-medium text-oq-black">{lot.name}</td>
          <td class="py-3 px-3 text-right text-oq-text">{formatSurface(lot.surface)}</td>
          <td class="py-3 px-3 text-right text-oq-text">{formatEur(lot.rent_hc)}</td>
          <td class="py-3 px-3 text-right text-oq-text">{formatEur(lot.charges)}</td>
          <td class="py-3 px-3 text-right font-semibold text-oq-black">
            {formatEur(lot.rent_hc + lot.charges)}
          </td>
          <td class="py-3 pl-3 text-right">
            <Badge text={LOT_STATUS_LABELS[lot.status]} variant={statusVariant(lot.status)} />
          </td>
        </tr>
      ))}
      <tr class="bg-oq-bg">
        <td class="py-3 pr-3 font-bold text-oq-black">Total</td>
        <td class="py-3 px-3"></td>
        <td class="py-3 px-3 text-right font-bold text-oq-black">{formatEur(totalHC)}</td>
        <td class="py-3 px-3 text-right font-bold text-oq-black">{formatEur(totalCharges)}</td>
        <td class="py-3 px-3 text-right font-extrabold text-oq-black">{formatEur(totalCC)}</td>
        <td class="py-3 pl-3"></td>
      </tr>
    </tbody>
  </table>
</div>
