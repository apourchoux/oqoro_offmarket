---
import { formatEur } from '../../lib/format';
import type { Property, PropertyFinancials, PropertyPhoto } from '../../lib/types';

export interface HeroStat {
  num: string;
  lbl: string;
}
export interface HeroFeatured {
  property: Property;
  financials: PropertyFinancials;
  primary_photo: PropertyPhoto | null;
}

interface Props {
  count: number;
  heroStats: HeroStat[];
  featured: HeroFeatured | null;
  featuredCandidates?: HeroFeatured[];
  featuredYieldLabel: string | null;
  featuredOccupancyLabel: string | null;
}

const {
  count,
  heroStats,
  featured,
  featuredCandidates = [],
  featuredYieldLabel,
  featuredOccupancyLabel,
} = Astro.props;

const FALLBACK_IMG = 'https://images.unsplash.com/photo-1502672023488-70e25813eb80?w=1200&q=80';
const heroImage = featured?.primary_photo?.url ?? FALLBACK_IMG;

// Payload pour la rotation client : on n'envoie que les champs utilisés par
// le script (slug, image, libellés). Évite d'embarquer tout l'objet Property.
const candidatesPayload = featuredCandidates.map((c) => ({
  slug: c.property.slug,
  title: c.property.title,
  city: c.property.city ?? c.property.address ?? '',
  surface: c.property.total_surface,
  price: formatEur(c.property.sale_price),
  image: c.primary_photo?.url ?? FALLBACK_IMG,
  yieldLabel: `${c.financials.gross_yield.toLocaleString('fr-FR', {
    minimumFractionDigits: 1,
    maximumFractionDigits: 2,
  })} %`,
  occupancyLabel:
    c.property.zone_occupancy_rate !== null
      ? `${Math.round(c.property.zone_occupancy_rate)} %`
      : null,
  rentLabel: formatEur(c.financials.monthly_rent_cc),
}));

// Évite qu'un titre/ville admin contenant `</script>` ne casse le parsing
// du <script type="application/json"> intégré.
const candidatesJson = JSON.stringify(candidatesPayload)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<section class="hero">
  <div class="oq-container">
    <div class="hero-grid">
      <div>
        <span class="oq-eyebrow">
          <span class="dot"></span>
          Exclusivité OQORO{count > 0 ? ` · ${count} bien${count > 1 ? 's' : ''} disponible${count > 1 ? 's' : ''}` : ''}
        </span>
        <h1>
          L'investissement locatif avec les
          <em><span class="groovy-under">vraies données</span></em>.
        </h1>
        <p class="lede">
          Nos biens en gestion à la vente, avec les revenus locatifs réels et
          le taux d'occupation vérifié. Une information que personne d'autre
          n'a sur le marché de la transaction.
        </p>
        <div class="ctas">
          <a href="#biens" class="oq-btn oq-btn-primary">
            Découvrir nos biens
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="#pourquoi" class="oq-btn oq-btn-secondary">Comment ça marche</a>
        </div>
        <div class="hero-trust">
          {heroStats.map((s) => (
            <div class="item">
              <div class="num">{s.num}</div>
              <div class="lbl">{s.lbl}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-media">
          <img src={heroImage} alt="Bien parisien" data-hero-img />
          <div class="ribbon">
            <span class="oq-pulse-dot"></span>
            Visite 3D disponible
          </div>
        </div>

        <div class="data-badge">
          <span class="data-badge-ic" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <div>
            <div class="t">Données certifiées</div>
            <div class="s">Tirées des encaissements OQORO sur 12 mois</div>
          </div>
        </div>

        {featured && (
          <a
            href={`/biens/${featured.property.slug}`}
            class="featured-card"
            data-featured-link
          >
            <div class="fh">
              <span class="fh-tag">Bien vedette</span>
              <span class="fh-price" data-featured-price>{formatEur(featured.property.sale_price)}</span>
            </div>
            <div class="ftitle" data-featured-title>{featured.property.title}</div>
            <div class="fsub">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span data-featured-sub>
                {featured.property.city ?? featured.property.address ?? ''}
                {featured.property.total_surface ? ` · ${featured.property.total_surface} m²` : ''}
              </span>
            </div>
            <div class="fstats">
              <div class="fstat"><div class="v" data-stat-yield>{featuredYieldLabel}</div><div class="l">Rendement</div></div>
              <div
                class="fstat"
                data-stat-occupancy-wrap
                hidden={!featuredOccupancyLabel}
              >
                <div class="v" data-stat-occupancy>{featuredOccupancyLabel ?? ''}</div>
                <div class="l">Occupation zone</div>
              </div>
              <div class="fstat"><div class="v" data-stat-rent>{formatEur(featured.financials.monthly_rent_cc)}</div><div class="l">Loyer encaissé</div></div>
            </div>
          </a>
        )}

        {candidatesPayload.length > 1 && (
          <script
            is:inline
            type="application/json"
            id="featured-candidates-data"
            set:html={candidatesJson}
          />
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 56px 0 120px;
    background:
      radial-gradient(60% 80% at 90% 10%, rgba(247, 104, 99, 0.08) 0%, rgba(255, 255, 255, 0) 60%),
      linear-gradient(180deg, #FAF9F6 0%, #FFFFFF 100%);
    border-bottom: 1px solid var(--border-tertiary);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .hero h1 {
    font-size: 64px;
    line-height: 1.15;
    letter-spacing: -2.5px;
    margin: 24px 0 44px;
    font-weight: 800;
  }
  .hero h1 em { color: var(--oqoro-purple); font-style: normal; }
  .hero .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--fg-secondary);
    max-width: 540px;
    margin: 0 0 32px;
  }
  .hero .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-trust {
    margin-top: 36px;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid var(--border-tertiary);
  }
  .hero-trust .item { display: flex; flex-direction: column; }
  .hero-trust .num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--fg-heading);
    line-height: 1;
  }
  .hero-trust .lbl { font-size: 13px; color: var(--fg-tertiary); margin-top: 6px; }

  .hero-right { position: relative; }

  .hero-media {
    position: relative;
    aspect-ratio: 5 / 6;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(34, 26, 91, 0.20), 0 0 0 1px var(--border-secondary);
  }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; }
  .hero-media::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.45) 100%);
    pointer-events: none;
  }
  .hero-media .ribbon {
    position: absolute;
    top: 20px;
    left: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.96);
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--fg-heading);
    box-shadow: var(--shadow-xs);
  }

  .data-badge {
    position: absolute;
    right: -32px;
    top: 60px;
    background: #fff;
    border-radius: 14px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--border-secondary);
    width: 220px;
  }
  .data-badge-ic {
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .data-badge .t { font-size: 13px; font-weight: 700; color: var(--fg-heading); line-height: 1.2; }
  .data-badge .s { font-size: 11px; color: var(--fg-tertiary); margin-top: 2px; }

  .featured-card {
    position: absolute;
    left: -36px;
    bottom: -28px;
    width: 320px;
    background: #fff;
    border-radius: 20px;
    padding: 18px;
    box-shadow: var(--shadow-xl), 0 0 0 1px var(--border-secondary);
    text-decoration: none;
    color: inherit;
    transition: transform .25s, box-shadow .25s;
  }
  .featured-card:hover { transform: translateY(-3px); text-decoration: none; }
  .featured-card .fh {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .featured-card .fh-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-700);
    background: var(--brand-50);
    padding: 3px 8px;
    border-radius: 6px;
  }
  .featured-card .fh-price {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    color: var(--fg-heading);
    letter-spacing: -0.5px;
  }
  .featured-card .ftitle {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--fg-heading);
    letter-spacing: -0.3px;
    margin: 0 0 4px;
    line-height: 1.25;
  }
  .featured-card .fsub {
    font-size: 13px;
    color: var(--fg-tertiary);
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .featured-card .fstats {
    display: flex;
    border-top: 1px solid var(--border-tertiary);
    padding-top: 12px;
  }
  .featured-card .fstat { flex: 1; min-width: 0; }
  .featured-card .fstat .v {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    color: var(--brand-700);
    letter-spacing: -0.5px;
    line-height: 1.1;
  }
  .featured-card .fstat .l { font-size: 11px; color: var(--fg-tertiary); margin-top: 3px; }
  .featured-card .fstat + .fstat { border-left: 1px solid var(--border-tertiary); padding-left: 12px; }
  .featured-card .fstat:not(:last-child) { padding-right: 12px; }

  @media (max-width: 1024px) {
    .hero { padding: 48px 0 96px; }
    .hero-grid { grid-template-columns: 1fr; gap: 56px; }
    .hero h1 { font-size: 48px; letter-spacing: -2px; margin-bottom: 36px; }
    .data-badge { display: none; }
    .featured-card { left: 16px; bottom: 16px; right: auto; }
  }
  @media (max-width: 640px) {
    .hero { padding: 32px 0 64px; }
    .hero h1 { font-size: 36px; letter-spacing: -1.5px; margin-bottom: 28px; }
    .hero-trust { gap: 20px; }
    .featured-card { width: calc(100% - 32px); }
  }
</style>

<script>
  // Rotation client : quand plusieurs biens sont marqués « vedette » côté
  // admin, on retire au hasard à chaque chargement pour que la home varie
  // même quand la page est servie depuis le cache CDN (max-age=60s).
  // Sans JS, l'utilisateur voit le tirage serveur déjà rendu.
  type Candidate = {
    slug: string;
    title: string;
    city: string;
    surface: number | null;
    price: string;
    image: string;
    yieldLabel: string;
    occupancyLabel: string | null;
    rentLabel: string;
  };

  const dataEl = document.getElementById('featured-candidates-data');
  if (dataEl?.textContent) {
    let candidates: Candidate[] = [];
    try {
      candidates = JSON.parse(dataEl.textContent) as Candidate[];
    } catch {
      candidates = [];
    }

    if (candidates.length > 1) {
      const pick = candidates[Math.floor(Math.random() * candidates.length)];

      const img = document.querySelector<HTMLImageElement>('[data-hero-img]');
      const link = document.querySelector<HTMLAnchorElement>('[data-featured-link]');
      const price = document.querySelector<HTMLElement>('[data-featured-price]');
      const title = document.querySelector<HTMLElement>('[data-featured-title]');
      const sub = document.querySelector<HTMLElement>('[data-featured-sub]');
      const yieldEl = document.querySelector<HTMLElement>('[data-stat-yield]');
      const occupancyWrap = document.querySelector<HTMLElement>('[data-stat-occupancy-wrap]');
      const occupancyEl = document.querySelector<HTMLElement>('[data-stat-occupancy]');
      const rentEl = document.querySelector<HTMLElement>('[data-stat-rent]');

      if (img) img.src = pick.image;
      if (link) link.href = `/biens/${pick.slug}`;
      if (price) price.textContent = pick.price;
      if (title) title.textContent = pick.title;
      if (sub) {
        sub.textContent =
          pick.city + (pick.surface ? ` · ${pick.surface} m²` : '');
      }
      if (yieldEl) yieldEl.textContent = pick.yieldLabel;
      if (rentEl) rentEl.textContent = pick.rentLabel;
      if (occupancyWrap && occupancyEl) {
        if (pick.occupancyLabel) {
          occupancyEl.textContent = pick.occupancyLabel;
          occupancyWrap.hidden = false;
        } else {
          occupancyWrap.hidden = true;
        }
      }
    }
  }
</script>
