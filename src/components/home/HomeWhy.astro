---
const cards = [
  {
    title: 'Loyers de marché vérifiés',
    desc: "Loyers, charges, durées de bail : nos 10 000+ lots en gestion donnent la vraie grille du quartier, type de bien par type de bien.",
    svg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>',
  },
  {
    title: 'Quartier sous le microscope',
    desc: "Taux d'occupation, vacance moyenne, profils d'impayés : on connaît les forces et les pièges de chaque adresse avant de la mettre en vente.",
    svg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>',
  },
  {
    title: 'Gestion clé en main',
    desc: "Déjà loué ou à transformer en investissement locatif : on enchaîne sur la gestion, sans rupture, avec des locataires solvables et des baux qui tiennent.",
    svg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.85 12.15 19 4"/><path d="m18 5 2 2"/><path d="m15 8 2 2"/></svg>',
  },
  {
    title: 'Visite 3D Matterport',
    desc: 'La plupart des biens sont disponibles en visite virtuelle Matterport haute fidélité avant tout déplacement.',
    svg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
  },
];
---

<section id="pourquoi" class="why">
  <div class="oq-container">
    <div class="oq-section-head">
      <span class="oq-eyebrow"><span class="dot"></span>Notre approche</span>
      <h2>On vend ce qu'on <em>connaît</em>.</h2>
      <p>
        10 000+ logements en gestion, des dizaines de villes couvertes : on
        sait ce qu'un quartier rapporte, qui paie son loyer et où les bonnes
        affaires se cachent. Vous achetez en off-market, mais surtout en
        terrain familier.
      </p>
    </div>

    <div class="why-grid">
      {cards.map((c) => (
        <div class="why-card">
          <div class="ico" set:html={c.svg}></div>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why { padding: 96px 0; background: var(--oqoro-cream); }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .why-card {
    background: #fff;
    border-radius: 20px;
    padding: 28px 24px;
    border: 1px solid var(--border-secondary);
    transition: transform .25s, box-shadow .25s;
  }
  .why-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .why-card .ico {
    width: 56px;
    height: 56px;
    background: var(--brand-50);
    color: var(--brand-700);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    box-shadow: 0 0 0 1px var(--border-secondary), var(--shadow-xs);
  }
  .why-card .ico :global(svg) { width: 28px; height: 28px; }
  .why-card h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--fg-heading);
    letter-spacing: -0.3px;
    margin: 0 0 8px;
  }
  .why-card p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-secondary);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .why { padding: 72px 0; }
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .why { padding: 56px 0; }
    .why-grid { grid-template-columns: 1fr; }
  }
</style>
