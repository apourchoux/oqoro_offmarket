---
import PropertyCard from '../PropertyCard.astro';
import type { Property, PropertyFinancials, PropertyPhoto } from '../../lib/types';
import { PROPERTY_TYPE_LABELS } from '../../lib/types';

interface Item {
  property: Property;
  financials: PropertyFinancials;
  primary_photo: PropertyPhoto | null;
}

interface Props {
  items: Item[];
  count: number;
  loadError: string | null;
}

const { items, count, loadError } = Astro.props;

const cityCounts = new Map<string, number>();
const typeCounts = new Map<string, number>();
for (const { property } of items) {
  if (property.city) {
    cityCounts.set(property.city, (cityCounts.get(property.city) ?? 0) + 1);
  }
  if (property.property_type) {
    typeCounts.set(property.property_type, (typeCounts.get(property.property_type) ?? 0) + 1);
  }
}

const cities = Array.from(cityCounts.entries()).sort((a, b) => b[1] - a[1]);
const types = Array.from(typeCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<section id="biens" class="biens">
  <div class="oq-container">
    <div class="biens-head">
      <div>
        <span class="oq-eyebrow">
          <span class="dot"></span>
          {count > 0
            ? `${count} bien${count > 1 ? 's' : ''} disponible${count > 1 ? 's' : ''}`
            : 'Mises à jour régulières'}
        </span>
        <h2>Nos biens en exclusivité.</h2>
        <div class="sub">
          Mise à jour quotidienne : chaque bien vient de notre portefeuille en
          gestion.
        </div>
      </div>
    </div>

    {items.length > 0 && (
      <div class="biens-toolbar">
        <div class="biens-filters" role="tablist">
          <button class="filter-chip active" type="button" data-filter-city="" data-filter-type="">
            Tous · {items.length}
          </button>
          {cities.map(([city, n]) => (
            <button class="filter-chip" type="button" data-filter-city={city} data-filter-type="">
              {city} · {n}
            </button>
          ))}
          {types.map(([t, n]) => (
            <button class="filter-chip" type="button" data-filter-city="" data-filter-type={t}>
              {PROPERTY_TYPE_LABELS[t as keyof typeof PROPERTY_TYPE_LABELS] ?? t} · {n}
            </button>
          ))}
        </div>
        <label class="biens-sort">
          <span>Trier</span>
          <select id="biens-sort">
            <option value="recent">Plus récents</option>
            <option value="price-asc">Prix croissant</option>
            <option value="price-desc">Prix décroissant</option>
            <option value="yield-desc">Rendement décroissant</option>
            <option value="surface-desc">Surface décroissante</option>
          </select>
        </label>
      </div>
    )}

    {loadError && (
      <div class="biens-error">
        Impossible de charger les biens : {loadError}.
      </div>
    )}

    {!loadError && items.length === 0 && (
      <div class="biens-empty">
        <h3>Aucun bien actuellement disponible</h3>
        <p>
          Nous publions régulièrement de nouveaux mandats. Laissez-nous votre
          email pour être averti en priorité.
        </p>
        <form class="biens-empty-form" method="POST" action="/api/leads">
          <input type="hidden" name="source" value="empty-state" />
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
          <input type="email" name="email" required placeholder="votre@email.com" class="oq-input" />
          <button type="submit" class="oq-btn oq-btn-primary">M'alerter</button>
        </form>
      </div>
    )}

    {items.length > 0 && (
      <div class="biens-grid" id="biens-grid">
        {items.map(({ property, financials, primary_photo }) => (
          <PropertyCard
            property={property}
            financials={financials}
            primaryPhoto={primary_photo}
          />
        ))}
      </div>
    )}

    {items.length > 0 && (
      <div class="biens-empty-filter" id="biens-empty-filter" hidden>
        Aucun bien ne correspond à ce filtre. <button type="button" class="reset-filter">Réinitialiser</button>
      </div>
    )}

    <div class="biens-foot">
      <span class="biens-foot-ic" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 2l9 7.5"/><path d="M5 9v11a1 1 0 0 0 1 1h4v-7h4v7h4a1 1 0 0 0 1-1V9"/></svg>
      </span>
      <div class="copy">
        <b>Vous ne trouvez pas votre bonheur ?</b>
        <span>
          Nous publions de nouveaux mandats chaque semaine. Recevez les
          annonces avant qu'elles soient en ligne.
        </span>
      </div>
      <a href="#alerte" class="oq-btn oq-btn-dark">
        M'alerter en priorité
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .biens { padding: 96px 0; background: #fff; }
  .biens-head { margin-bottom: 24px; }
  .biens-head h2 {
    font-size: 44px;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin: 16px 0 8px;
  }
  .biens-head .sub { color: var(--fg-tertiary); font-size: 15px; }

  .biens-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .biens-filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .filter-chip {
    background: #fff;
    border: 1px solid var(--border-primary);
    color: var(--fg-secondary);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .2s, color .2s, border-color .2s;
    font-family: inherit;
  }
  .filter-chip:hover { background: var(--gray-50); }
  .filter-chip.active {
    background: var(--oqoro-blue);
    color: #fff;
    border-color: var(--oqoro-blue);
  }

  .biens-sort {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--fg-tertiary);
  }
  .biens-sort select {
    background: #fff;
    border: 1px solid var(--border-primary);
    border-radius: 8px;
    padding: 7px 28px 7px 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-heading);
    font-family: inherit;
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%2361646C' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 10px center;
  }

  .biens-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .biens-empty {
    background: var(--oqoro-cream);
    border-radius: 18px;
    padding: 48px 32px;
    text-align: center;
    border: 1px solid var(--border-secondary);
  }
  .biens-empty h3 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--fg-heading);
    margin: 0 0 8px;
  }
  .biens-empty p {
    font-size: 15px;
    color: var(--fg-secondary);
    margin: 0 auto 24px;
    max-width: 480px;
  }
  .biens-empty-form {
    display: flex;
    gap: 8px;
    max-width: 420px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .biens-empty-form .oq-input { flex: 1; min-width: 200px; }
  .biens-empty-form .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .biens-empty-filter {
    padding: 32px;
    text-align: center;
    background: var(--oqoro-cream);
    border-radius: 14px;
    color: var(--fg-secondary);
    font-size: 14px;
    margin-top: 24px;
  }
  .biens-empty-filter .reset-filter {
    background: none;
    border: none;
    color: var(--brand-600);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    font-family: inherit;
    font-size: 14px;
    padding: 0;
    margin-left: 4px;
  }

  .biens-error {
    padding: 16px 20px;
    border-radius: 12px;
    background: #FEF3F2;
    color: #B42318;
    border: 1px solid #FECDCA;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .biens-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 48px;
    padding: 24px 32px;
    background: var(--oqoro-cream);
    border-radius: 16px;
    flex-wrap: wrap;
  }
  .biens-foot-ic {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 14px;
    background: var(--brand-50);
    color: var(--brand-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 1px var(--border-secondary);
  }
  .biens-foot .copy { flex: 1; min-width: 240px; }
  .biens-foot .copy b {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--fg-heading);
    display: block;
    margin-bottom: 2px;
    font-weight: 700;
  }
  .biens-foot .copy span { font-size: 14px; color: var(--fg-tertiary); }

  @media (max-width: 1024px) {
    .biens { padding: 72px 0; }
    .biens-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .biens { padding: 56px 0; }
    .biens-grid { grid-template-columns: 1fr; }
    .biens-head h2 { font-size: 32px; }
    .biens-toolbar { flex-direction: column; align-items: stretch; }
  }
</style>

<script>
  const grid = document.getElementById('biens-grid');
  const sortSelect = document.getElementById('biens-sort') as HTMLSelectElement | null;
  const emptyFilter = document.getElementById('biens-empty-filter');
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const resetBtn = document.querySelector<HTMLButtonElement>('.reset-filter');

  if (grid) {
    let filterCity = '';
    let filterType = '';
    let sort = 'recent';

    function applyFilters() {
      const cards = Array.from(grid!.querySelectorAll<HTMLAnchorElement>('.bien-card'));
      let visible = 0;
      for (const card of cards) {
        const c = card.getAttribute('data-city') ?? '';
        const t = card.getAttribute('data-type') ?? '';
        const matchCity = !filterCity || c === filterCity;
        const matchType = !filterType || t === filterType;
        const show = matchCity && matchType;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (emptyFilter) emptyFilter.hidden = visible !== 0;
    }

    function applySort() {
      const cards = Array.from(grid!.querySelectorAll<HTMLAnchorElement>('.bien-card'));
      const num = (el: HTMLElement, attr: string) => Number(el.getAttribute(attr) ?? '0');
      const date = (el: HTMLElement, attr: string) => {
        const v = el.getAttribute(attr);
        return v ? new Date(v).getTime() : 0;
      };
      cards.sort((a, b) => {
        switch (sort) {
          case 'price-asc': return num(a, 'data-price') - num(b, 'data-price');
          case 'price-desc': return num(b, 'data-price') - num(a, 'data-price');
          case 'yield-desc': return num(b, 'data-yield') - num(a, 'data-yield');
          case 'surface-desc': return num(b, 'data-surface') - num(a, 'data-surface');
          case 'recent':
          default: return date(b, 'data-published') - date(a, 'data-published');
        }
      });
      const frag = document.createDocumentFragment();
      cards.forEach((c) => frag.appendChild(c));
      grid!.appendChild(frag);
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        filterCity = chip.getAttribute('data-filter-city') ?? '';
        filterType = chip.getAttribute('data-filter-type') ?? '';
        applyFilters();
      });
    });

    sortSelect?.addEventListener('change', () => {
      sort = sortSelect.value;
      applySort();
    });

    resetBtn?.addEventListener('click', () => {
      const allChip = chips[0];
      if (allChip) allChip.click();
    });
  }
</script>
