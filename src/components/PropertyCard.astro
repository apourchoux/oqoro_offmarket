---
import type { Property, PropertyFinancials, PropertyPhoto } from '../lib/types';
import { PROPERTY_TYPE_LABELS } from '../lib/types';
import { formatEur, formatSurface, photoUrl } from '../lib/format';

interface Props {
  property: Property;
  financials: PropertyFinancials;
  primaryPhoto: PropertyPhoto | null;
}

const { property, financials, primaryPhoto } = Astro.props;

const typeLabel = property.property_type
  ? PROPERTY_TYPE_LABELS[property.property_type]
  : 'Bien';

const yieldLabel = `${financials.gross_yield.toLocaleString('fr-FR', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 2,
})} %`;

const occupancyPct =
  financials.total_lots > 0
    ? Math.round((financials.rented_lots / financials.total_lots) * 100)
    : null;
const occupancyLabel = occupancyPct !== null ? `${occupancyPct} %` : '—';

const rentLabel = formatEur(financials.monthly_rent_cc);
const pricePerM =
  property.total_surface && property.total_surface > 0
    ? `${formatEur(Math.round(property.sale_price / property.total_surface))}/m²`
    : null;

const matterport = Boolean(property.matterport_url);
const locality = property.city
  ? property.postal_code
    ? `${property.city} (${property.postal_code.slice(0, 2)})`
    : property.city
  : property.address || '';
---

<a
  href={`/biens/${property.slug}`}
  class="bien-card group"
  data-city={property.city ?? ''}
  data-type={property.property_type ?? ''}
  data-price={property.sale_price}
  data-yield={financials.gross_yield}
  data-surface={property.total_surface ?? 0}
  data-published={property.published_at ?? ''}
>
  <div class="bien-img">
    {primaryPhoto ? (
      <img
        src={photoUrl(primaryPhoto.url, 600)}
        alt={primaryPhoto.label ?? property.title}
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-oq-muted text-sm bg-oq-cream">
        Pas de photo
      </div>
    )}
    <div class="badges">
      <span class="b dark">{typeLabel}</span>
      {matterport && <span class="b">Visite 3D</span>}
    </div>
    {matterport && (
      <div class="visit3d">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        Visite 3D
      </div>
    )}
  </div>

  <div class="bien-body">
    <div class="bien-loc">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      {locality || '—'}
    </div>
    <h3 class="bien-title">{property.title}</h3>
    <div class="bien-meta">
      {property.nb_rooms && <span>{property.nb_rooms} pièces</span>}
      {property.nb_rooms && property.total_surface && <span class="dot-sep"></span>}
      {property.total_surface && <span>{formatSurface(property.total_surface)}</span>}
      {(property.nb_rooms || property.total_surface) && property.dpe_energy_class && <span class="dot-sep"></span>}
      {property.dpe_energy_class && <span>DPE {property.dpe_energy_class}</span>}
    </div>

    <div class="bien-stats">
      <div class="bstat"><div class="v">{yieldLabel}</div><div class="l">Rendement</div></div>
      <div class="bstat"><div class="v">{occupancyLabel}</div><div class="l">Occupation</div></div>
      <div class="bstat"><div class="v">{rentLabel}</div><div class="l">Loyer/mois</div></div>
    </div>

    <div class="bien-foot">
      <div class="bien-price">
        {formatEur(property.sale_price)}
        {pricePerM && <span class="sub">{pricePerM}</span>}
      </div>
      <div class="arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </div>
    </div>
  </div>
</a>

<style>
  .bien-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid var(--border-secondary);
    overflow: hidden;
    cursor: pointer;
    transition: transform .25s, box-shadow .25s, border-color .25s;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .bien-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--border-primary);
    text-decoration: none;
  }

  .bien-img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--gray-100);
  }
  .bien-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s;
  }
  .bien-card:hover .bien-img img { transform: scale(1.04); }

  .bien-img .badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .bien-img .b {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.96);
    color: var(--fg-heading);
    padding: 5px 10px;
    border-radius: 6px;
    text-transform: uppercase;
  }
  .bien-img .b.dark { background: var(--oqoro-blue); color: #fff; }
  .bien-img .b.saumon { background: var(--oqoro-saumon); color: #fff; }

  .bien-img .visit3d {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(12, 17, 29, 0.6);
    color: #fff;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .bien-body { padding: 18px 20px 20px; }

  .bien-loc {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }

  .bien-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--fg-heading);
    letter-spacing: -0.3px;
    margin: 0 0 6px;
    line-height: 1.25;
  }

  .bien-meta {
    display: flex;
    gap: 10px;
    font-size: 13px;
    color: var(--fg-secondary);
    margin-bottom: 18px;
    align-items: center;
    flex-wrap: wrap;
  }
  .bien-meta .dot-sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--gray-300);
    display: inline-block;
  }

  .bien-stats {
    background: var(--oqoro-cream);
    border-radius: 12px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 14px 0;
    margin-bottom: 18px;
    position: relative;
  }
  .bien-stats::before {
    content: 'Données certifiées OQORO';
    position: absolute;
    top: -8px;
    left: 12px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-700);
    background: #fff;
    padding: 0 6px;
  }
  .bstat { padding: 0 14px; text-align: left; }
  .bstat + .bstat { border-left: 1px solid var(--border-secondary); }
  .bstat .v {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    color: var(--brand-700);
    letter-spacing: -0.5px;
    line-height: 1.05;
  }
  .bstat .l {
    font-size: 10px;
    font-weight: 600;
    color: var(--fg-tertiary);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bien-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--border-tertiary);
  }
  .bien-price {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: var(--fg-heading);
    letter-spacing: -0.6px;
    line-height: 1;
  }
  .bien-price .sub {
    display: block;
    font-size: 11px;
    color: var(--fg-tertiary);
    font-weight: 500;
    margin-top: 4px;
    letter-spacing: 0;
  }
  .bien-foot .arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand-700);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .25s, color .25s, transform .25s;
  }
  .bien-card:hover .bien-foot .arrow {
    background: var(--brand-600);
    color: #fff;
    transform: translateX(2px);
  }
</style>
