---
import type { Property, PropertyFinancials, PropertyPhoto } from '../lib/types';
import { PROPERTY_TYPE_LABELS } from '../lib/types';
import { formatEur, formatSurface } from '../lib/format';
import Badge from './Badge.astro';

interface Props {
  property: Property;
  financials: PropertyFinancials;
  primaryPhoto: PropertyPhoto | null;
}

const { property, financials, primaryPhoto } = Astro.props;

const typeLabel = property.property_type
  ? PROPERTY_TYPE_LABELS[property.property_type]
  : 'Bien';

const occupancyLabel =
  financials.total_lots > 0
    ? `${financials.rented_lots}/${financials.total_lots} loués`
    : null;
---

<a
  href={`/biens/${property.slug}`}
  class="oq-card oq-card-hover block no-underline group"
>
  <div class="relative aspect-[4/3] bg-oq-bg overflow-hidden">
    {primaryPhoto ? (
      <img
        src={primaryPhoto.url}
        alt={primaryPhoto.label ?? property.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-oq-muted text-sm">
        Pas de photo
      </div>
    )}
    <div class="absolute top-3 left-3 flex gap-2">
      <Badge text={typeLabel} variant="dark" />
    </div>
    {occupancyLabel && (
      <div class="absolute top-3 right-3">
        <Badge text={occupancyLabel} variant="green" />
      </div>
    )}
  </div>
  <div class="p-5">
    <div class="flex items-start justify-between gap-3 mb-2">
      <h3 class="text-[16px] font-semibold text-oq-black line-clamp-1">
        {property.city ?? property.title}
      </h3>
      {property.total_surface && (
        <span class="text-[13px] text-oq-muted shrink-0">
          {formatSurface(property.total_surface)}
        </span>
      )}
    </div>
    <p class="text-[14px] text-oq-muted line-clamp-1 mb-4">
      {property.address}{property.neighborhood ? ` · ${property.neighborhood}` : ''}
    </p>
    <div class="flex items-end justify-between">
      <div>
        <div class="text-[12px] text-oq-muted">Prix</div>
        <div class="text-[20px] font-extrabold text-oq-black leading-tight">
          {formatEur(property.sale_price)}
        </div>
      </div>
      <div class="text-right">
        <div class="text-[12px] text-oq-muted">Rendement brut</div>
        <div class="text-[18px] font-extrabold text-oq-orange leading-tight">
          {financials.gross_yield.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 2 })} %
        </div>
      </div>
    </div>
  </div>
</a>
