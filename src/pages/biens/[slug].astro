---
import Base from '../../layouts/Base.astro';
import PropertyGallery from '../../components/property/PropertyGallery.astro';
import PropertyTitleBlock from '../../components/property/PropertyTitleBlock.astro';
import PropertyVisit3D from '../../components/property/PropertyVisit3D.astro';
import PropertyDescription from '../../components/property/PropertyDescription.astro';
import PropertyFeatures from '../../components/property/PropertyFeatures.astro';
import PropertyProfitability from '../../components/property/PropertyProfitability.astro';
import PropertyDiagFinancier from '../../components/property/PropertyDiagFinancier.astro';
import PropertyHistoryBoxes from '../../components/property/PropertyHistoryBoxes.astro';
import PropertyMarket from '../../components/property/PropertyMarket.astro';
import PropertyDPEBars from '../../components/property/PropertyDPEBars.astro';
import PropertyLocation from '../../components/property/PropertyLocation.astro';
import PropertyBuyCard from '../../components/property/PropertyBuyCard.astro';
import PropertyCtaFinal from '../../components/property/PropertyCtaFinal.astro';
import ContactModal from '../../components/ContactModal.tsx';
import { getPropertyFull } from '../../lib/supabase';
import { formatEur } from '../../lib/format';
import { PROPERTY_TYPE_LABELS } from '../../lib/types';

export const prerender = false;

const { slug } = Astro.params as { slug: string };
const data = await getPropertyFull(slug);

if (!data) {
  return Astro.redirect('/404');
}

const { property, photos, transports, annual_reports, financials } = data;

const typeLabel = property.property_type
  ? PROPERTY_TYPE_LABELS[property.property_type]
  : null;

const heroPhoto = photos.find((p) => p.is_primary)?.url ?? photos[0]?.url;

const title =
  property.meta_title ??
  `${typeLabel ?? 'Bien'} ${property.total_surface ? `${property.total_surface}m² ` : ''}— ${formatEur(property.sale_price)} — ${property.city ?? ''}`;

const description =
  property.meta_description ??
  `${typeLabel ?? 'Bien'} ${property.address ? `${property.address}, ` : ''}${property.city ?? ''}. Rendement brut ${financials.gross_yield.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 2 })}%. Données locatives certifiées OQORO.`;

const ogImage = heroPhoto;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://offmarket.oqoro.com';
const canonical = `${siteUrl}/biens/${property.slug}`;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: property.title,
  description,
  ...(ogImage ? { image: ogImage } : {}),
  offers: {
    '@type': 'Offer',
    price: property.sale_price,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: canonical,
  },
};
---

<Base
  title={title}
  description={description}
  image={ogImage}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <div class="bien-wrap">
    <nav class="crumbs">
      <a href="/">OQORO Off Market</a>
      <span class="sep">/</span>
      <a href="/#biens">Nos biens</a>
      {property.city && (
        <>
          <span class="sep">/</span>
          <span>{property.city}</span>
        </>
      )}
      <span class="sep">/</span>
      <b>{property.title}</b>
    </nav>

    <PropertyGallery photos={photos} title={property.title} matterportUrl={property.matterport_url} />

    <div class="bien-grid">
      <div class="col-left">
        <PropertyTitleBlock property={property} financials={financials} />
        <PropertyVisit3D matterportUrl={property.matterport_url} bgImage={heroPhoto} />
        <PropertyDescription description={property.description} />
        <PropertyFeatures property={property} financials={financials} />
        <PropertyProfitability financials={financials} />
        <PropertyDiagFinancier financials={financials} />
        <PropertyHistoryBoxes reports={annual_reports} />
        <PropertyMarket property={property} financials={financials} />
        <PropertyDPEBars
          energyClass={property.dpe_energy_class}
          energyValue={property.dpe_energy_value}
          gesClass={property.dpe_ges_class}
          gesValue={property.dpe_ges_value}
          energyCost={property.dpe_energy_cost}
        />
        <PropertyLocation property={property} transports={transports} />
      </div>
      <PropertyBuyCard property={property} financials={financials} />
    </div>

    <PropertyCtaFinal />
  </div>

  <ContactModal
    client:load
    propertyId={property.id}
    propertyTitle={property.title}
    propertyAddress={`${property.address ?? ''}${property.city ? `, ${property.city}` : ''}`}
    propertyPrice={formatEur(property.sale_price)}
  />
</Base>

<style>
  .bien-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .crumbs {
    padding: 16px 0;
    font-size: 13px;
    color: var(--fg-tertiary);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .crumbs a { color: var(--fg-tertiary); text-decoration: none; }
  .crumbs a:hover { color: var(--fg-heading); }
  .crumbs .sep { color: var(--gray-300); }
  .crumbs b { color: var(--fg-primary); font-weight: 500; }

  .bien-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: flex-start;
    padding-bottom: 48px;
  }
  .col-left { min-width: 0; }

  @media (max-width: 1024px) {
    .bien-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .bien-wrap { padding: 0 20px; }
  }
</style>
