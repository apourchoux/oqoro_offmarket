---
import Base from '../../layouts/Base.astro';
import PropertyGallery from '../../components/property/PropertyGallery.astro';
import PropertyTitleBlock from '../../components/property/PropertyTitleBlock.astro';
import PropertyVisit3D from '../../components/property/PropertyVisit3D.astro';
import PropertyDescription from '../../components/property/PropertyDescription.astro';
import PropertyFeatures from '../../components/property/PropertyFeatures.astro';
import PropertyProfitability from '../../components/property/PropertyProfitability.astro';
import PropertyDiagFinancier from '../../components/property/PropertyDiagFinancier.astro';
import PropertyHistoryBoxes from '../../components/property/PropertyHistoryBoxes.astro';
import PropertyMarket from '../../components/property/PropertyMarket.astro';
import PropertyDPEBars from '../../components/property/PropertyDPEBars.astro';
import PropertyLocation from '../../components/property/PropertyLocation.astro';
import PropertyExternalLinks from '../../components/property/PropertyExternalLinks.astro';
import PropertyBuyCard from '../../components/property/PropertyBuyCard.astro';
import PropertyCtaFinal from '../../components/property/PropertyCtaFinal.astro';
import ContactModal from '../../components/ContactModal.tsx';
import { getPropertyFull } from '../../lib/supabase';
import { formatEur } from '../../lib/format';
import { PROPERTY_TYPE_LABELS } from '../../lib/types';
import { safeHttpUrl } from '../../lib/security';

export const prerender = false;

const { slug } = Astro.params as { slug: string };
const data = await getPropertyFull(slug);

if (!data) {
  return Astro.redirect('/404');
}

// Cache fiche bien : 60s sur le navigateur + Netlify edge,
// 5 min de stale-while-revalidate (les fiches changent rarement, on accepte un peu de retard).
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=60, stale-while-revalidate=300',
);

const { property, photos, transports, annual_reports, financials } = data;

// Toutes les URL externes éditables côté admin passent par safeHttpUrl :
// neutralise les `javascript:`, `data:`, etc. qui pourraient être injectés
// via la fiche admin (défense en profondeur, en plus de la contrainte SQL).
const safeMatterportUrl = safeHttpUrl(property.matterport_url);
const safeOqoroListingUrl = safeHttpUrl(property.oqoro_listing_url);
const safeSaleListingUrl = safeHttpUrl(property.sale_listing_url);

const typeLabel = property.property_type
  ? PROPERTY_TYPE_LABELS[property.property_type]
  : null;

const heroPhoto = photos.find((p) => p.is_primary)?.url ?? photos[0]?.url;

const title =
  property.meta_title ??
  `${typeLabel ?? 'Bien'} ${property.total_surface ? `${property.total_surface}m² ` : ''}— ${formatEur(property.sale_price)} — ${property.city ?? ''}`;

const description =
  property.meta_description ??
  `${typeLabel ?? 'Bien'} ${property.address ? `${property.address}, ` : ''}${property.city ?? ''}. Rendement brut ${financials.gross_yield.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 2 })}%. Données locatives certifiées OQORO.`;

const ogImage = heroPhoto;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://offmarket.oqoro.com';
const canonical = `${siteUrl}/biens/${property.slug}`;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: property.title,
  description,
  ...(ogImage ? { image: ogImage } : {}),
  offers: {
    '@type': 'Offer',
    price: property.sale_price,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: canonical,
  },
};
---

<Base
  title={title}
  description={description}
  image={ogImage}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <div class="bien-wrap">
    <div class="crumbs-bar">
      <nav class="crumbs">
        <a href="/">OQORO Off Market</a>
        <span class="sep">/</span>
        <a href="/#biens">Nos biens</a>
        {property.city && (
          <>
            <span class="sep">/</span>
            <span>{property.city}</span>
          </>
        )}
        <span class="sep">/</span>
        <b>{property.title}</b>
      </nav>
      <button type="button" class="share-btn" id="share-btn" aria-label="Partager ce bien" data-share-title={property.title} data-share-url={canonical}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        <span>Partager</span>
      </button>
    </div>

    <PropertyGallery photos={photos} title={property.title} matterportUrl={safeMatterportUrl} />

    <div class="bien-grid">
      <div class="col-left">
        <PropertyTitleBlock property={property} financials={financials} />
        <PropertyVisit3D matterportUrl={safeMatterportUrl} bgImage={heroPhoto} />
        <PropertyDescription description={property.description} />
        <PropertyFeatures property={property} financials={financials} />
        <PropertyProfitability property={property} financials={financials} />
        <PropertyDiagFinancier property={property} financials={financials} />
        <PropertyHistoryBoxes reports={annual_reports} />
        <PropertyMarket property={property} />
        <PropertyDPEBars
          energyClass={property.dpe_energy_class}
          energyValue={property.dpe_energy_value}
          gesClass={property.dpe_ges_class}
          gesValue={property.dpe_ges_value}
          energyCost={property.dpe_energy_cost}
        />
        <PropertyLocation property={property} transports={transports} />
        <PropertyExternalLinks
          oqoroListingUrl={safeOqoroListingUrl}
          saleListingUrl={safeSaleListingUrl}
        />
      </div>
      <PropertyBuyCard property={property} financials={financials} />
    </div>

    <PropertyCtaFinal />
  </div>

  <ContactModal
    client:load
    propertyId={property.id}
    propertyTitle={property.title}
    propertyAddress={`${property.address ?? ''}${property.city ? `, ${property.city}` : ''}`}
    propertyPrice={formatEur(property.sale_price)}
  />
</Base>

<style>
  .bien-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .crumbs-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
  }
  .crumbs {
    font-size: 13px;
    color: var(--fg-tertiary);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .crumbs a { color: var(--fg-tertiary); text-decoration: none; }
  .crumbs a:hover { color: var(--fg-heading); }
  .crumbs .sep { color: var(--gray-300); }
  .crumbs b { color: var(--fg-primary); font-weight: 500; }

  .share-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: #fff;
    border: 1px solid var(--border-primary);
    border-radius: 8px;
    color: var(--fg-secondary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .2s, color .2s, border-color .2s;
  }
  .share-btn:hover {
    background: var(--gray-50);
    color: var(--fg-heading);
  }
  .share-btn.copied {
    background: #ECFDF3;
    color: #067647;
    border-color: #ABEFC6;
  }
  .share-btn svg { width: 14px; height: 14px; }

  .bien-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: flex-start;
    padding-bottom: 48px;
  }
  .col-left { min-width: 0; }

  @media (max-width: 1024px) {
    .bien-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .bien-wrap { padding: 0 20px; }
    .crumbs-bar { flex-direction: column; align-items: flex-start; gap: 8px; }
    .share-btn { align-self: flex-end; }
  }
</style>

<script>
  // Lecture des données via data-* attributes plutôt que via define:vars :
  // contourne la CVE Astro GHSA-j687-52p2-xcff (tag fermant script mal échappé).
  const btn = document.getElementById('share-btn');
  if (btn) {
    const shareTitle = btn.getAttribute('data-share-title') ?? document.title;
    const shareUrl = btn.getAttribute('data-share-url') ?? location.href;
    btn.addEventListener('click', async () => {
      try {
        if (navigator.share) {
          await navigator.share({ title: shareTitle, url: shareUrl });
          return;
        }
      } catch {
        // user cancelled or share unsupported, fall through to copy
      }
      try {
        await navigator.clipboard.writeText(shareUrl);
        const label = btn.querySelector('span');
        const original = label?.textContent ?? 'Partager';
        if (label) label.textContent = 'Lien copié !';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = original;
        }, 2000);
      } catch {
        prompt('Copiez le lien :', shareUrl);
      }
    });
  }
</script>
