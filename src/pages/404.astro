---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable · OQORO Off Market" noindex>
  <section class="oq-container py-24 text-center">
    <div class="text-[12px] font-bold uppercase tracking-wider text-oq-muted mb-4">
      404
    </div>
    <h1 class="text-[32px] md:text-[40px] font-extrabold text-oq-black mb-4">
      Cette page n'existe pas
    </h1>
    <p class="text-oq-text max-w-md mx-auto mb-8">
      Le bien que vous cherchez a peut-être été retiré de la vente, ou l'URL
      est incorrecte.
    </p>
    <a href="/" class="oq-btn-dark">Retour à l'accueil</a>
  </section>
</Base>
