---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeProof from '../components/home/HomeProof.astro';
import HomeWhy from '../components/home/HomeWhy.astro';
import HomeBiens from '../components/home/HomeBiens.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import HomeCta from '../components/home/HomeCta.astro';
import { listPublishedProperties } from '../lib/supabase';

export const prerender = false;

// Cache court : la home reflète les nouvelles publications après ~60s sans rebuild,
// mais reste rapide grâce au CDN + stale-while-revalidate.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=60, stale-while-revalidate=300',
);

let items: Awaited<ReturnType<typeof listPublishedProperties>> = [];
let loadError: string | null = null;

try {
  items = await listPublishedProperties();
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Erreur inconnue';
  console.error('[home] listPublishedProperties failed:', err);
}

const count = items.length;

// Biens cochés « Mettre en avant » côté admin. Fallback : dernier bien publié
// (équivalent au comportement historique) si personne n'a coché la case.
const featuredCandidates = items.filter((x) => x.property.is_featured);
const heroCandidates = featuredCandidates.length > 0 ? featuredCandidates : items.slice(0, 1);

// Choix initial côté serveur : aléatoire si plusieurs vedettes, pour que la
// première peinture varie même quand JS n'est pas exécuté. Le client refait
// un tirage au chargement pour casser le cache CDN (cf. HomeHero).
const featured = heroCandidates.length > 0
  ? heroCandidates[Math.floor(Math.random() * heroCandidates.length)]
  : null;

const featuredYieldLabel = featured
  ? `${featured.financials.gross_yield.toLocaleString('fr-FR', {
      minimumFractionDigits: 1,
      maximumFractionDigits: 2,
    })} %`
  : null;

// Sur la fiche d'appel home, l'occupation = donnée de marché (taux locatif
// du quartier renseigné en admin). Pas le statut courant des lots, qui chute
// mécaniquement à 0 % quand le bien est vidé pour la mise en vente.
const featuredOccupancyLabel =
  featured && featured.property.zone_occupancy_rate !== null
    ? `${Math.round(featured.property.zone_occupancy_rate)} %`
    : null;

const avgYield =
  count > 0
    ? items.reduce((s, x) => s + x.financials.gross_yield, 0) / count
    : null;

const avgOccupancy = (() => {
  const withZone = items.filter(
    (x) => x.property.zone_occupancy_rate !== null,
  );
  if (withZone.length === 0) return null;
  const sum = withZone.reduce(
    (s, x) => s + (x.property.zone_occupancy_rate ?? 0),
    0,
  );
  return Math.round(sum / withZone.length);
})();

const heroStats = [
  {
    num: count > 0 ? String(count) : '—',
    lbl: count > 1 ? 'Biens disponibles' : 'Bien disponible',
  },
  {
    num:
      avgYield !== null
        ? `${avgYield.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} %`
        : '—',
    lbl: 'Rendement brut moyen',
  },
  {
    num: avgOccupancy !== null ? `${avgOccupancy} %` : '—',
    lbl: 'Occupation moyenne du marché',
  },
  { num: '7 ans', lbl: "D'historique de gestion" },
];

const title = 'OQORO Off Market — Investissement locatif, données certifiées';
const description =
  "Nos biens en gestion à la vente, avec les revenus locatifs réels, le taux d'occupation vérifié et la gestion incluse.";
---

<Base title={title} description={description}>
  <HomeHero
    count={count}
    heroStats={heroStats}
    featured={featured}
    featuredCandidates={heroCandidates}
    featuredYieldLabel={featuredYieldLabel}
    featuredOccupancyLabel={featuredOccupancyLabel}
  />
  <HomeProof />
  <HomeWhy />
  <HomeBiens items={items} count={count} loadError={loadError} />
  <HomeTestimonials />
  <HomeCta />
</Base>
