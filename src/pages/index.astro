---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeProof from '../components/home/HomeProof.astro';
import HomeWhy from '../components/home/HomeWhy.astro';
import HomeBiens from '../components/home/HomeBiens.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import HomeCta from '../components/home/HomeCta.astro';
import { listPublishedProperties } from '../lib/supabase';

export const prerender = false;

// Cache court : la home reflète les nouvelles publications après ~60s sans rebuild,
// mais reste rapide grâce au CDN + stale-while-revalidate.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=60, stale-while-revalidate=300',
);

let items: Awaited<ReturnType<typeof listPublishedProperties>> = [];
let loadError: string | null = null;

try {
  items = await listPublishedProperties();
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Erreur inconnue';
  console.error('[home] listPublishedProperties failed:', err);
}

const count = items.length;
const featured = items[0] ?? null;

const featuredYieldLabel = featured
  ? `${featured.financials.gross_yield.toLocaleString('fr-FR', {
      minimumFractionDigits: 1,
      maximumFractionDigits: 2,
    })} %`
  : null;

const featuredOccupancyLabel = featured
  ? featured.financials.total_lots > 0
    ? `${Math.round((featured.financials.rented_lots / featured.financials.total_lots) * 100)} %`
    : '—'
  : null;

const avgYield =
  count > 0
    ? items.reduce((s, x) => s + x.financials.gross_yield, 0) / count
    : null;

const avgOccupancy = (() => {
  const withLots = items.filter((x) => x.financials.total_lots > 0);
  if (withLots.length === 0) return null;
  const sum = withLots.reduce(
    (s, x) => s + x.financials.rented_lots / x.financials.total_lots,
    0,
  );
  return Math.round((sum / withLots.length) * 100);
})();

const heroStats = [
  {
    num: count > 0 ? String(count) : '—',
    lbl: count > 1 ? 'Biens disponibles' : 'Bien disponible',
  },
  {
    num:
      avgYield !== null
        ? `${avgYield.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} %`
        : '—',
    lbl: 'Rendement net moyen',
  },
  {
    num: avgOccupancy !== null ? `${avgOccupancy} %` : '—',
    lbl: "Taux d'occupation moyen",
  },
  { num: '7 ans', lbl: "D'historique de gestion" },
];

const title = 'OQORO Off Market — Investissement locatif, données certifiées';
const description =
  "Nos biens en gestion à la vente, avec les revenus locatifs réels, le taux d'occupation vérifié et la gestion incluse.";
---

<Base title={title} description={description}>
  <HomeHero
    count={count}
    heroStats={heroStats}
    featured={featured}
    featuredYieldLabel={featuredYieldLabel}
    featuredOccupancyLabel={featuredOccupancyLabel}
  />
  <HomeProof />
  <HomeWhy />
  <HomeBiens items={items} count={count} loadError={loadError} />
  <HomeTestimonials />
  <HomeCta />
</Base>
