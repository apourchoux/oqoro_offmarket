---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { getAdminClient } from '../../lib/supabase';
import { LEAD_STATUS_LABELS } from '../../lib/types';

// Défense en profondeur : si le middleware était contourné (cf. CVE Astro),
// chaque page admin re-vérifie la présence d'un user authentifié.
if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}

const supabase = getAdminClient();

const [
  { count: totalCount },
  { count: publishedCount },
  { data: recentLeads },
] = await Promise.all([
  supabase.from('properties').select('*', { count: 'exact', head: true }),
  supabase
    .from('properties')
    .select('*', { count: 'exact', head: true })
    .eq('status', 'published'),
  supabase
    .from('leads')
    .select('*, properties(title, city)')
    .order('created_at', { ascending: false })
    .limit(5),
]);
---

<Admin title="Tableau de bord" activeSection="dashboard">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-[28px] font-extrabold text-oq-black">Tableau de bord</h1>
    <a href="/admin/biens/new" class="oq-btn-dark">Ajouter un bien</a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="bg-white border border-oq-border rounded-card p-6">
      <div class="text-[12px] font-semibold uppercase tracking-wider text-oq-muted">
        Biens publiés
      </div>
      <div class="text-[32px] font-extrabold text-oq-black mt-2">
        {publishedCount ?? 0}
      </div>
      <div class="text-[13px] text-oq-muted mt-1">
        sur {totalCount ?? 0} au total
      </div>
    </div>
    <div class="bg-white border border-oq-border rounded-card p-6">
      <div class="text-[12px] font-semibold uppercase tracking-wider text-oq-muted">
        Leads (30 derniers jours)
      </div>
      <div class="text-[32px] font-extrabold text-oq-black mt-2">
        {recentLeads?.length ?? 0}
      </div>
      <div class="text-[13px] text-oq-muted mt-1">
        <a href="/admin/leads" class="text-oq-orange no-underline">Voir tous les leads →</a>
      </div>
    </div>
    <div class="bg-white border border-oq-border rounded-card p-6">
      <div class="text-[12px] font-semibold uppercase tracking-wider text-oq-muted">
        Dernière publication
      </div>
      <div class="text-[14px] font-semibold text-oq-black mt-2">
        {publishedCount && publishedCount > 0 ? 'Récente' : 'Aucune publication'}
      </div>
    </div>
  </div>

  <div class="bg-white border border-oq-border rounded-card overflow-hidden">
    <div class="px-6 py-4 border-b border-oq-border flex items-center justify-between">
      <h2 class="text-[16px] font-semibold text-oq-black">5 derniers leads</h2>
      <a href="/admin/leads" class="text-[13px] text-oq-orange no-underline">
        Tous les leads →
      </a>
    </div>
    {recentLeads && recentLeads.length > 0 ? (
      <table class="w-full text-[14px]">
        <thead>
          <tr class="text-left text-[12px] uppercase tracking-wider text-oq-muted bg-oq-bg">
            <th class="px-6 py-3 font-semibold">Nom</th>
            <th class="px-6 py-3 font-semibold">Email</th>
            <th class="px-6 py-3 font-semibold">Bien</th>
            <th class="px-6 py-3 font-semibold">Statut</th>
            <th class="px-6 py-3 font-semibold">Date</th>
          </tr>
        </thead>
        <tbody>
          {recentLeads.map((lead: any) => (
            <tr class="border-t border-oq-border">
              <td class="px-6 py-3 font-medium text-oq-black">
                {lead.first_name} {lead.last_name}
              </td>
              <td class="px-6 py-3 text-oq-text">{lead.email}</td>
              <td class="px-6 py-3 text-oq-text">
                {lead.properties?.title ?? '—'}
              </td>
              <td class="px-6 py-3">
                <span class="inline-flex items-center rounded-badge bg-oq-bg px-2.5 py-0.5 text-[12px] font-semibold text-oq-text">
                  {LEAD_STATUS_LABELS[lead.status as keyof typeof LEAD_STATUS_LABELS]}
                </span>
              </td>
              <td class="px-6 py-3 text-oq-muted text-[13px]">
                {new Date(lead.created_at).toLocaleDateString('fr-FR')}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <div class="p-10 text-center text-oq-muted">
        Aucun lead pour le moment.
      </div>
    )}
  </div>
</Admin>
