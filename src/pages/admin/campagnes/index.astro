---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import CampaignsNav from '../../../components/admin/CampaignsNav.astro';
import CampaignsTable from '../../../components/admin/CampaignsTable.tsx';
import type { CampaignRow } from '../../../components/admin/CampaignsTable.tsx';
import { getAdminClient } from '../../../lib/supabase';
import { triggerDueScheduledCampaigns } from '../../../lib/campaign-trigger';
import { formatRate } from '../../../lib/format';
import type { CampaignStats } from '../../../lib/types';

if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}

const supabase = getAdminClient();

// Filet de sécurité du cron : les campagnes programmées dont l'échéance est
// passée partent dès l'ouverture de cette page (claim atomique, best-effort).
await triggerDueScheduledCampaigns(supabase);
const [{ data: campaigns }, { data: lists }] = await Promise.all([
  supabase
    .from('campaigns')
    .select('*, properties(title)')
    .order('created_at', { ascending: false }),
  supabase.from('contact_lists').select('id, name'),
]);

const ids = (campaigns ?? []).map((c: any) => c.id);
const { data: statsRows } = ids.length
  ? await supabase.from('campaign_stats').select('*').in('campaign_id', ids)
  : { data: [] };
const statsByCampaign = new Map<string, CampaignStats>(
  ((statsRows ?? []) as CampaignStats[]).map((s) => [s.campaign_id, s]),
);
const listNames = new Map<string, string>(
  (lists ?? []).map((l: any) => [l.id, l.name]),
);

const rows: CampaignRow[] = (campaigns ?? []).map((c: any) => {
  const stats = statsByCampaign.get(c.id) ?? null;
  return {
    ...c,
    property_title: c.properties?.title ?? null,
    stats: stats
      ? {
          delivered: stats.delivered,
          opened: stats.opened,
          clicked: stats.clicked,
          bounced: stats.bounced + stats.failed,
          unsubscribed: stats.unsubscribed ?? 0,
        }
      : null,
    target_list_names: (c.target_list_ids ?? [])
      .map((id: string) => listNames.get(id))
      .filter(Boolean),
  };
});

// Tuiles agrégées (toutes campagnes envoyées confondues).
const totals = ((statsRows ?? []) as CampaignStats[]).reduce(
  (acc, s) => ({
    sent: acc.sent + s.sent,
    delivered: acc.delivered + s.delivered,
    opened: acc.opened + s.opened,
    clicked: acc.clicked + s.clicked,
  }),
  { sent: 0, delivered: 0, opened: 0, clicked: 0 },
);

const deliveredRate = formatRate(totals.delivered, totals.sent);
const tiles = [
  { label: 'Envoyés', value: totals.sent.toLocaleString('fr-FR'), sub: 'emails', accent: 'bg-brand-600' },
  { label: 'Délivrés', value: totals.delivered.toLocaleString('fr-FR'), sub: deliveredRate === '—' ? '' : `${deliveredRate} de taux`, accent: 'bg-violet-500' },
  { label: 'Ouverts', value: formatRate(totals.opened, totals.delivered), sub: `${totals.opened.toLocaleString('fr-FR')} ouvertures`, accent: 'bg-emerald-500' },
  { label: 'Cliqués', value: formatRate(totals.clicked, totals.delivered), sub: `${totals.clicked.toLocaleString('fr-FR')} clics`, accent: 'bg-sky-500' },
];
---

<Admin title="Campagnes" activeSection="campagnes">
  <div class="space-y-4 mb-6 lg:mb-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-[24px] sm:text-[28px] font-extrabold text-oq-black">Campagnes email</h1>
        <p class="text-oq-muted text-[14px] mt-1">
          {rows.length} campagne{rows.length > 1 ? 's' : ''}
        </p>
      </div>
      <a href="/admin/campagnes/new" class="oq-btn-dark w-full sm:w-auto whitespace-nowrap">Créer une campagne</a>
    </div>
    <CampaignsNav active="campagnes" />
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4 mb-8">
    {tiles.map((t) => (
      <div class="bg-white border border-oq-border rounded-card overflow-hidden">
        <div class="p-4 sm:p-5">
          <div class="text-[12px] uppercase tracking-wider text-oq-muted font-semibold">
            {t.label}
          </div>
          <div class="text-[24px] sm:text-[28px] font-extrabold text-oq-black mt-1">{t.value}</div>
          {t.sub && <div class="text-[13px] text-oq-muted">{t.sub}</div>}
        </div>
        <div class={`h-1 ${t.accent}`} />
      </div>
    ))}
  </div>

  <CampaignsTable client:load initialCampaigns={rows} />
</Admin>
