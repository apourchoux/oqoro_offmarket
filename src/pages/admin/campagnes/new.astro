---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import CampaignComposer from '../../../components/admin/CampaignComposer.tsx';
import { getAdminClient } from '../../../lib/supabase';
import { loadComposerData } from '../../../lib/campaigns';

if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}

const supabase = getAdminClient();
const { properties, lists, templates } = await loadComposerData(supabase);
const defaultFrom = import.meta.env.RESEND_FROM || '';
---

<Admin title="Nouvelle campagne" activeSection="campagnes">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-[24px] font-extrabold text-oq-black">Nouvelle campagne</h1>
    <a href="/admin/campagnes" class="oq-btn-secondary">← Retour</a>
  </div>
  <CampaignComposer
    client:load
    properties={properties}
    lists={lists}
    templates={templates}
    defaultFrom={defaultFrom}
  />
</Admin>
