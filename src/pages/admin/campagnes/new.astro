---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import CampaignCreate from '../../../components/admin/CampaignCreate.tsx';

if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}
---

<Admin title="Nouvelle campagne" activeSection="campagnes">
  <div class="mb-6">
    <a href="/admin/campagnes" class="inline-flex items-center min-h-[32px] text-[13px] text-oq-muted hover:text-oq-black no-underline">
      ← Retour aux campagnes
    </a>
  </div>
  <CampaignCreate client:load />
</Admin>
