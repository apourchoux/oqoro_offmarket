---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import CampaignsNav from '../../../components/admin/CampaignsNav.astro';
import ContactsTable from '../../../components/admin/ContactsTable.tsx';
import { getAdminClient } from '../../../lib/supabase';
import type { Contact } from '../../../lib/types';

if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}

const supabase = getAdminClient();
const [{ data: contacts }, { data: lists }] = await Promise.all([
  supabase.from('contacts').select('*').order('created_at', { ascending: false }),
  supabase.from('contact_lists').select('id, name').order('name'),
]);
---

<Admin title="Contacts" activeSection="campagnes">
  <div class="space-y-4 mb-6 lg:mb-8">
    <div>
      <h1 class="text-[24px] sm:text-[28px] font-extrabold text-oq-black">Contacts</h1>
      <p class="text-oq-muted text-[14px] mt-1">
        {(contacts ?? []).length} au total
      </p>
    </div>
    <CampaignsNav active="contacts" />
  </div>
  <ContactsTable
    client:load
    initialContacts={(contacts ?? []) as Contact[]}
    lists={(lists ?? []) as Array<{ id: string; name: string }>}
  />
</Admin>
