---
export const prerender = false;

import { Resend } from 'resend';
import Admin from '../../../layouts/Admin.astro';
import CampaignsNav from '../../../components/admin/CampaignsNav.astro';

if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}

// Diagnostic des domaines Resend : statut de vérification + tracking
// opens/clicks (nécessaire pour les statistiques d'ouverture/clic).
interface DomainDiag {
  id: string;
  name: string;
  status: string;
  region: string | null;
  openTracking: boolean | null;
  clickTracking: boolean | null;
  records: Array<{ record: string; name: string; type: string; status: string }>;
}

const apiKey = import.meta.env.RESEND_API_KEY;
let domains: DomainDiag[] = [];
let resendError: string | null = null;

if (apiKey) {
  try {
    const resend = new Resend(apiKey);
    const { data: listData, error } = await resend.domains.list();
    if (error) {
      resendError = error.message;
    } else {
      const items = ((listData as any)?.data ?? []) as any[];
      domains = await Promise.all(
        items.map(async (d) => {
          // Le détail expose les enregistrements DNS et le tracking.
          const { data: full } = await resend.domains.get(d.id);
          const f = full as any;
          const pick = (obj: any, keys: string[]): boolean | null => {
            for (const k of keys) {
              if (typeof obj?.[k] === 'boolean') return obj[k];
            }
            return null;
          };
          return {
            id: d.id,
            name: d.name,
            status: d.status,
            region: d.region ?? null,
            openTracking: pick(f, ['open_tracking', 'openTracking']),
            clickTracking: pick(f, ['click_tracking', 'clickTracking']),
            records: (f?.records ?? []).map((r: any) => ({
              record: r.record,
              name: r.name,
              type: r.type,
              status: r.status,
            })),
          };
        }),
      );
    }
  } catch (err) {
    resendError = err instanceof Error ? err.message : 'Erreur Resend inconnue';
  }
}

const envChecks = [
  { key: 'RESEND_API_KEY', ok: Boolean(import.meta.env.RESEND_API_KEY), hint: "Clé API Resend (envoi d'emails)" },
  { key: 'RESEND_FROM', ok: Boolean(import.meta.env.RESEND_FROM), hint: 'Expéditeur par défaut des campagnes' },
  { key: 'RESEND_WEBHOOK_SECRET', ok: Boolean(import.meta.env.RESEND_WEBHOOK_SECRET), hint: 'Signing secret du webhook (statistiques ouvertures/clics/bounces)' },
  { key: 'CAMPAIGN_FUNCTION_SECRET', ok: Boolean(import.meta.env.CAMPAIGN_FUNCTION_SECRET), hint: "Secret de la fonction d'envoi en arrière-plan" },
];
const allEnvOk = envChecks.every((c) => c.ok);
---

<Admin title="Configuration" activeSection="campagnes">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-[28px] font-extrabold text-oq-black">Configuration</h1>
      <p class="text-oq-muted text-[14px] mt-1">
        Diagnostic des domaines Resend et du tracking
      </p>
    </div>
    <CampaignsNav active="configuration" />
  </div>

  <div class="bg-white border border-oq-border rounded-card p-6 mb-6">
    <h2 class="text-[17px] font-bold text-oq-black mb-1">Domaines Resend</h2>
    <p class="text-[13px] text-oq-muted mb-5">
      Vérification de la configuration open tracking et click tracking sur vos
      domaines Resend. Si le tracking est désactivé, les événements d'ouverture
      et de clic ne seront pas détectés.
    </p>

    {!apiKey ? (
      <div class="px-4 py-3 bg-red-50 border border-red-200 rounded-btn text-[13px] text-red-800">
        RESEND_API_KEY non configurée — impossible d'interroger Resend.
      </div>
    ) : resendError ? (
      <div class="px-4 py-3 bg-red-50 border border-red-200 rounded-btn text-[13px] text-red-800">
        Erreur Resend : {resendError}
      </div>
    ) : domains.length === 0 ? (
      <div class="px-4 py-3 bg-amber-50 border border-amber-200 rounded-btn text-[13px] text-amber-800">
        Aucun domaine dans ce compte Resend. Ajoutez et vérifiez un domaine
        d'envoi dans le dashboard Resend.
      </div>
    ) : (
      <div class="space-y-4">
        {domains.map((d) => {
          const trackingOk = d.openTracking === true && d.clickTracking === true;
          return (
            <div class="border border-oq-border rounded-card p-5">
              <div class="flex items-center gap-3 mb-1">
                <span class="text-[16px] font-bold text-oq-black">{d.name}</span>
                <span class:list={[
                  'inline-flex items-center text-[11px] font-bold px-2.5 py-0.5 rounded-full',
                  d.status === 'verified' ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800',
                ]}>
                  {d.status}
                </span>
              </div>
              <div class="text-[13px] text-oq-muted mb-4">
                {d.region ? `Region: ${d.region} · ` : ''}ID: {d.id}
              </div>

              <div class="grid sm:grid-cols-2 gap-3 mb-3">
                <div class:list={[
                  'px-4 py-2.5 rounded-btn border text-[14px] font-medium',
                  d.openTracking === true ? 'bg-emerald-50 border-emerald-200 text-emerald-700' :
                  d.openTracking === false ? 'bg-red-50 border-red-200 text-red-700' :
                  'bg-oq-bg border-oq-border text-oq-muted',
                ]}>
                  {d.openTracking === true ? '✓ Open Tracking : Actif' :
                   d.openTracking === false ? '✕ Open Tracking : Inactif' :
                   'Open Tracking : à vérifier dans le dashboard Resend'}
                </div>
                <div class:list={[
                  'px-4 py-2.5 rounded-btn border text-[14px] font-medium',
                  d.clickTracking === true ? 'bg-emerald-50 border-emerald-200 text-emerald-700' :
                  d.clickTracking === false ? 'bg-red-50 border-red-200 text-red-700' :
                  'bg-oq-bg border-oq-border text-oq-muted',
                ]}>
                  {d.clickTracking === true ? '✓ Click Tracking : Actif' :
                   d.clickTracking === false ? '✕ Click Tracking : Inactif' :
                   'Click Tracking : à vérifier dans le dashboard Resend'}
                </div>
              </div>

              {trackingOk && (
                <div class="px-4 py-2.5 rounded-btn border bg-emerald-50 border-emerald-200 text-emerald-700 text-[14px] font-medium mb-3">
                  ✓ Configuration OK — le tracking est actif sur ce domaine.
                </div>
              )}
              {d.openTracking === false || d.clickTracking === false ? (
                <div class="px-4 py-2.5 rounded-btn border bg-amber-50 border-amber-200 text-amber-800 text-[13px] mb-3">
                  Activez le tracking dans Resend → Domains → {d.name} →
                  Configuration, sinon les taux d'ouverture et de clic resteront à 0.
                </div>
              ) : null}

              {d.records.length > 0 && (
                <details class="text-[13px]">
                  <summary class="cursor-pointer text-oq-muted font-medium">
                    Enregistrements DNS ({d.records.length})
                  </summary>
                  <table class="w-full text-[12px] mt-3">
                    <thead>
                      <tr class="text-left text-oq-muted uppercase tracking-wider">
                        <th class="py-1 pr-3 font-semibold">Type</th>
                        <th class="py-1 pr-3 font-semibold">Nom</th>
                        <th class="py-1 pr-3 font-semibold">Usage</th>
                        <th class="py-1 font-semibold">Statut</th>
                      </tr>
                    </thead>
                    <tbody>
                      {d.records.map((r) => (
                        <tr class="border-t border-oq-border">
                          <td class="py-1.5 pr-3 font-mono">{r.type}</td>
                          <td class="py-1.5 pr-3 font-mono break-all">{r.name}</td>
                          <td class="py-1.5 pr-3">{r.record}</td>
                          <td class="py-1.5">{r.status}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </details>
              )}
            </div>
          );
        })}
      </div>
    )}
  </div>

  <div class="bg-white border border-oq-border rounded-card p-6">
    <h2 class="text-[17px] font-bold text-oq-black mb-1">Variables d'environnement</h2>
    <p class="text-[13px] text-oq-muted mb-5">
      {allEnvOk
        ? 'Toutes les variables nécessaires aux campagnes sont configurées.'
        : 'Certaines variables manquent — les fonctionnalités correspondantes sont désactivées.'}
    </p>
    <ul class="space-y-2">
      {envChecks.map((c) => (
        <li class:list={[
          'flex items-center gap-3 px-4 py-2.5 rounded-btn border text-[14px]',
          c.ok ? 'bg-emerald-50 border-emerald-200' : 'bg-red-50 border-red-200',
        ]}>
          <span class:list={['font-bold', c.ok ? 'text-emerald-700' : 'text-red-700']}>
            {c.ok ? '✓' : '✕'}
          </span>
          <code class="font-mono text-[13px] text-oq-black">{c.key}</code>
          <span class="text-oq-muted text-[13px]">{c.hint}</span>
        </li>
      ))}
    </ul>
  </div>
</Admin>
