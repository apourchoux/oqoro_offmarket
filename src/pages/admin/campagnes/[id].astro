---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import CampaignWizard from '../../../components/admin/CampaignWizard.tsx';
import CampaignReport from '../../../components/admin/CampaignReport.tsx';
import type { ReportCampaign } from '../../../components/admin/CampaignReport.tsx';
import { getAdminClient } from '../../../lib/supabase';
import {
  audienceExcludedQuery,
  audienceQuery,
  loadCampaignPropertyData,
  loadComposerData,
} from '../../../lib/campaigns';
import {
  renderCampaignEmail,
  renderCustomEmail,
} from '../../../lib/campaign-email';
import type { Campaign, CampaignSender, CampaignStats } from '../../../lib/types';

if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}

const UUID_REGEX =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const id = Astro.params.id;
if (!id || !UUID_REGEX.test(id)) {
  return Astro.redirect('/admin/campagnes');
}

const supabase = getAdminClient();
const { data: campaignRow } = await supabase
  .from('campaigns')
  .select('*, properties(title, slug)')
  .eq('id', id)
  .maybeSingle();
if (!campaignRow) {
  return Astro.redirect('/admin/campagnes');
}
const campaign = campaignRow as Campaign & {
  properties: { title: string; slug: string } | null;
};
const isDraft = campaign.status === 'draft';

const defaultFrom = import.meta.env.RESEND_FROM || '';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://offmarket.oqoro.com';

// ─── Mode brouillon : assistant 4 étapes ───
let composerData: Awaited<ReturnType<typeof loadComposerData>> | null = null;
let senders: CampaignSender[] = [];

// ─── Autres statuts : rapport à onglets ───
let stats: CampaignStats | null = null;
let listNames: string[] = [];
let contentHtml: string | null = null;
let audienceCount: { active: number; excluded: number } | null = null;

if (isDraft) {
  const [data, { data: senderRows }] = await Promise.all([
    loadComposerData(supabase),
    supabase.from('campaign_senders').select('*').order('created_at', { ascending: true }),
  ]);
  composerData = data;
  senders = (senderRows ?? []) as CampaignSender[];
} else {
  const [{ data: statsRows }, { data: listRows }] = await Promise.all([
    supabase.from('campaign_stats').select('*').eq('campaign_id', id),
    campaign.target_list_ids && campaign.target_list_ids.length > 0
      ? supabase.from('contact_lists').select('id, name').in('id', campaign.target_list_ids)
      : Promise.resolve({ data: [] as Array<{ id: string; name: string }> }),
  ]);
  stats = ((statsRows ?? [])[0] as CampaignStats) ?? null;
  listNames = (listRows ?? []).map((l: any) => l.name);

  // Aperçu du contenu envoyé (onglet Contenu) : variables remplacées par des
  // données de démonstration, lien de désabonnement inerte.
  const demoContact = { first_name: 'Jean', last_name: 'Dupont', email: 'jean.dupont@exemple.fr' };
  if (campaign.content_mode === 'custom' && campaign.custom_html?.trim()) {
    contentHtml = renderCustomEmail({
      html: campaign.custom_html,
      previewText: campaign.preview_text,
      contact: demoContact,
      unsubscribeUrl: '#',
    }).html;
  } else if (campaign.content_mode !== 'custom' && campaign.property_id) {
    const data = await loadCampaignPropertyData(supabase, campaign.property_id);
    if (data) {
      contentHtml = renderCampaignEmail({
        campaign: {
          subject: campaign.subject,
          intro_text: campaign.intro_text,
          preview_text: campaign.preview_text,
        },
        property: data.property,
        financials: data.financials,
        photoUrl: data.photoUrl,
        contact: { first_name: demoContact.first_name },
        siteUrl: SITE_URL,
        unsubscribeUrl: '#',
      }).html;
    }
  }

  // Campagne programmée : compteur d'audience courant (actifs + exclus).
  if (campaign.status === 'scheduled') {
    const [{ count: active }, { count: excluded }] = await Promise.all([
      audienceQuery(supabase, campaign, 'id', { count: 'exact', head: true }),
      audienceExcludedQuery(supabase, campaign, 'id', { count: 'exact', head: true }),
    ]);
    audienceCount = { active: active ?? 0, excluded: excluded ?? 0 };
  }
}

const reportCampaign: ReportCampaign = {
  ...campaign,
  property_title: campaign.properties?.title ?? null,
  property_slug: campaign.properties?.slug ?? null,
};
---

<Admin title={campaign.name} activeSection="campagnes">
  {isDraft ? (
    <CampaignWizard
      client:load
      initialCampaign={campaign}
      properties={composerData!.properties}
      lists={composerData!.lists}
      senders={senders}
      defaultFrom={defaultFrom}
    />
  ) : (
    <CampaignReport
      client:load
      initialCampaign={reportCampaign}
      initialStats={stats}
      listNames={listNames}
      contentHtml={contentHtml}
      audienceCount={audienceCount}
    />
  )}
</Admin>
