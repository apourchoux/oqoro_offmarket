---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import CampaignsNav from '../../../components/admin/CampaignsNav.astro';
import TemplatesGrid from '../../../components/admin/TemplatesGrid.tsx';
import { getAdminClient } from '../../../lib/supabase';
import type { EmailTemplate } from '../../../lib/types';

if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}

const supabase = getAdminClient();
const { data: templates } = await supabase
  .from('email_templates')
  .select('*')
  .order('updated_at', { ascending: false });
---

<Admin title="Templates" activeSection="campagnes">
  <div class="space-y-4 mb-6 lg:mb-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-[24px] sm:text-[28px] font-extrabold text-oq-black">Templates</h1>
        <p class="text-oq-muted text-[14px] mt-1">
          Bibliothèque de modèles d'email réutilisables
        </p>
      </div>
      <a href="/admin/campagnes/templates/new" class="oq-btn-dark w-full sm:w-auto whitespace-nowrap">Nouveau template</a>
    </div>
    <CampaignsNav active="templates" />
  </div>
  <TemplatesGrid client:load initialTemplates={(templates ?? []) as EmailTemplate[]} />
</Admin>
