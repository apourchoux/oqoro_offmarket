---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import PropertyForm from '../../../components/admin/PropertyForm.tsx';
import { getAdminClient } from '../../../lib/supabase';

const { id } = Astro.params as { id: string };
const supabase = getAdminClient();

const [
  { data: property },
  { data: lots },
  { data: photos },
  { data: transports },
  { data: reports },
] = await Promise.all([
  supabase.from('properties').select('*').eq('id', id).maybeSingle(),
  supabase.from('property_lots').select('*').eq('property_id', id).order('sort_order'),
  supabase.from('property_photos').select('*').eq('property_id', id).order('sort_order'),
  supabase.from('property_transports').select('*').eq('property_id', id).order('sort_order'),
  supabase.from('property_annual_reports').select('*').eq('property_id', id).order('year', { ascending: false }),
]);

if (!property) {
  return Astro.redirect('/admin/biens');
}
---

<Admin title={`Éditer ${property.title}`} activeSection="biens">
  <div class="mb-6 flex items-center justify-between">
    <a href="/admin/biens" class="text-[13px] text-oq-muted hover:text-oq-black no-underline">
      ← Retour à la liste
    </a>
    {property.status === 'published' && (
      <a href={`/biens/${property.slug}`} target="_blank" class="text-[13px] text-oq-orange no-underline">
        Voir en ligne ↗
      </a>
    )}
  </div>
  <h1 class="text-[28px] font-extrabold text-oq-black mb-2">{property.title}</h1>
  <p class="text-oq-muted text-[14px] mb-8">
    {property.status === 'published' ? 'Publié' : 'Brouillon'}
  </p>

  <PropertyForm
    client:load
    mode="edit"
    initialProperty={property}
    initialLots={lots ?? []}
    initialPhotos={photos ?? []}
    initialTransports={transports ?? []}
    initialReports={reports ?? []}
  />
</Admin>
