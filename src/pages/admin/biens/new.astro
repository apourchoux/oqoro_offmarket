---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import PropertyForm from '../../../components/admin/PropertyForm.tsx';

if (!Astro.locals.user) {
  return Astro.redirect('/admin/login');
}
---

<Admin title="Nouveau bien" activeSection="biens">
  <div class="mb-4">
    <a href="/admin/biens" class="inline-flex items-center min-h-[32px] text-[13px] text-oq-muted hover:text-oq-black no-underline">
      ← Retour à la liste
    </a>
  </div>
  <h1 class="text-[24px] sm:text-[28px] font-extrabold text-oq-black mb-6 lg:mb-8">Nouveau bien</h1>

  <PropertyForm client:load mode="create" />
</Admin>
