---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import PropertyForm from '../../../components/admin/PropertyForm.tsx';
---

<Admin title="Nouveau bien" activeSection="biens">
  <div class="mb-6">
    <a href="/admin/biens" class="text-[13px] text-oq-muted hover:text-oq-black no-underline">
      ← Retour à la liste
    </a>
  </div>
  <h1 class="text-[28px] font-extrabold text-oq-black mb-8">Nouveau bien</h1>

  <PropertyForm client:load mode="create" />
</Admin>
