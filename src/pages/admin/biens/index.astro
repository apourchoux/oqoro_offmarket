---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import { getAdminClient } from '../../../lib/supabase';
import { formatEur } from '../../../lib/format';
import { PROPERTY_TYPE_LABELS } from '../../../lib/types';

const supabase = getAdminClient();

const [{ data: properties }, { data: photos }, { data: financials }] =
  await Promise.all([
    supabase.from('properties').select('*').order('updated_at', { ascending: false }),
    supabase.from('property_photos').select('property_id, url, is_primary, sort_order'),
    supabase.from('property_financials').select('*'),
  ]);

function getPrimaryPhoto(propId: string): string | null {
  const candidates = (photos ?? []).filter((p: any) => p.property_id === propId);
  candidates.sort(
    (a: any, b: any) =>
      (b.is_primary ? 1 : 0) - (a.is_primary ? 1 : 0) ||
      a.sort_order - b.sort_order,
  );
  return candidates[0]?.url ?? null;
}

function getYield(propId: string): number {
  const f = (financials ?? []).find((f: any) => f.id === propId);
  return f?.gross_yield ?? 0;
}
---

<Admin title="Biens" activeSection="biens">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-[28px] font-extrabold text-oq-black">Biens</h1>
    <div class="flex gap-3">
      <form method="POST" action="/admin/biens/rebuild">
        <button type="submit" class="oq-btn-secondary">Regénérer le site</button>
      </form>
      <a href="/admin/biens/new" class="oq-btn-dark">Ajouter un bien</a>
    </div>
  </div>

  <div class="bg-white border border-oq-border rounded-card overflow-hidden">
    {properties && properties.length > 0 ? (
      <table class="w-full text-[14px]">
        <thead>
          <tr class="text-left text-[12px] uppercase tracking-wider text-oq-muted bg-oq-bg">
            <th class="px-4 py-3 font-semibold w-16">Photo</th>
            <th class="px-4 py-3 font-semibold">Titre</th>
            <th class="px-4 py-3 font-semibold">Ville</th>
            <th class="px-4 py-3 font-semibold text-right">Prix</th>
            <th class="px-4 py-3 font-semibold text-right">Rendement</th>
            <th class="px-4 py-3 font-semibold">Statut</th>
            <th class="px-4 py-3 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {properties.map((p: any) => (
            <tr class="border-t border-oq-border">
              <td class="px-4 py-3">
                {getPrimaryPhoto(p.id) ? (
                  <img src={getPrimaryPhoto(p.id)!} alt="" class="w-12 h-12 rounded-btn object-cover" />
                ) : (
                  <div class="w-12 h-12 rounded-btn bg-oq-bg" />
                )}
              </td>
              <td class="px-4 py-3">
                <div class="font-medium text-oq-black line-clamp-1">{p.title}</div>
                <div class="text-[12px] text-oq-muted">
                  {p.property_type ? PROPERTY_TYPE_LABELS[p.property_type as keyof typeof PROPERTY_TYPE_LABELS] : '—'}
                </div>
              </td>
              <td class="px-4 py-3 text-oq-text">{p.city ?? '—'}</td>
              <td class="px-4 py-3 text-right font-semibold text-oq-black">
                {formatEur(p.sale_price)}
              </td>
              <td class="px-4 py-3 text-right font-semibold text-oq-orange">
                {getYield(p.id).toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 2 })} %
              </td>
              <td class="px-4 py-3">
                <span class:list={[
                  'inline-flex items-center rounded-badge px-2.5 py-0.5 text-[12px] font-semibold',
                  p.status === 'published' ? 'bg-oq-green-soft text-green-700' : 'bg-oq-bg text-oq-muted',
                ]}>
                  {p.status === 'published' ? 'Publié' : 'Brouillon'}
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <div class="flex justify-end gap-3">
                  <a href={`/biens/${p.slug}`} target="_blank" class="text-[13px] text-oq-muted hover:text-oq-black no-underline">Voir</a>
                  <a href={`/admin/biens/${p.id}`} class="text-[13px] text-oq-orange no-underline">Éditer</a>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <div class="p-16 text-center">
        <p class="text-oq-muted mb-6">Aucun bien pour le moment.</p>
        <a href="/admin/biens/new" class="oq-btn-dark">Créer le premier bien</a>
      </div>
    )}
  </div>
</Admin>
