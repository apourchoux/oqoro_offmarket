# Supabase
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# Resend (emails)
RESEND_API_KEY=re_xxxxx
RESEND_FROM=OQORO Off Market <noreply@example.com>
LEAD_NOTIFICATION_TO=lead@example.com
LEAD_NOTIFICATION_CC=manager@example.com

# Admin (comma-separated list of emails authorized to access /admin)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Netlify build hook (créé dans Site settings → Build & deploy → Build hooks)
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/xxxxxxxxxxxxxxxxxxxxxxxx

# Analytics
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public site URL (for canonical / OG)
PUBLIC_SITE_URL=https://example.com
